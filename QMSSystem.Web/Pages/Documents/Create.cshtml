@page
@model QMSSystem.Web.Pages.Documents.CreateModel
@{
    ViewData["Title"] = "Create Controlled Document";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 mb-1">New Controlled Document Request</h2>
            <p class="text-muted mb-0">Submit a new SOP or policy for controlled registration.</p>
        </div>
        <div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Admin/DocumentRegister/Index" class="btn btn-secondary btn-sm">Back to Register</a>
            }
            else
            {
                <a href="/Operator" class="btn btn-secondary btn-sm">Back to Dashboard</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-light">
            <span class="fw-semibold">Document Details</span>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Document.DocumentNumber" class="form-label">Document Number <span class="text-danger">*</span></label>
                        <input asp-for="Document.DocumentNumber" class="form-control" placeholder="e.g. SOP-QA-001" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Document.Department" class="form-label">Department <span class="text-danger">*</span></label>
                        <input asp-for="Document.Department" class="form-control" placeholder="e.g. Quality Assurance" required />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Document.Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Document.Title" class="form-control" placeholder="e.g. Cleanroom Sanitization Procedure" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Document.DocumentVersion" class="form-label">Initial Version</label>
                        <input asp-for="Document.DocumentVersion" class="form-control" type="number" readonly />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Document.Status" class="form-label">Initial Status</label>
                        <input asp-for="Document.Status" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label for="UploadFile" class="form-label">Document File Attachment</label>
                        <input type="file" id="UploadFile" name="UploadFile" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Document.Comment" class="form-label">Scope / Change Summary</label>
                        <textarea asp-for="Document.Comment" class="form-control" rows="3" placeholder="Brief summary of the document purpose or initial version notes..."></textarea>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit Document Request</button>
                        <a href="/Operator" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
