@page "/documents/create"
@model QMSSystem.Web.Pages.Documents.Create.IndexModel
@{
    ViewData["Title"] = "Create Document Request";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-2">QMS / DOCUMENT CONTROL</p>
            <h1 class="h3 mb-1">Create Document Request</h1>
            <p class="text-muted mb-0">Submit a controlled document for registration.</p>
        </div>
        <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <span class="fw-semibold">Document Details</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Document.DocumentNumber" class="form-label">Document Number</label>
                        <input asp-for="Document.DocumentNumber" class="form-control" required
                               placeholder="e.g. SOP-QA-001" />
                        <span asp-validation-for="Document.DocumentNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Document.Department" class="form-label">Department</label>
                        <input asp-for="Document.Department" class="form-control" required
                               placeholder="e.g. Quality Assurance" />
                        <span asp-validation-for="Document.Department" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Document.Title" class="form-label">Title</label>
                        <input asp-for="Document.Title" class="form-control" required
                               placeholder="Enter the document title" />
                        <span asp-validation-for="Document.Title" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Document.Comment" class="form-label">Scope / Change Summary</label>
                        <textarea asp-for="Document.Comment" class="form-control" rows="4"
                                  placeholder="Briefly describe the document purpose or changes."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <span class="fw-semibold">File Attachment</span>
            </div>
            <div class="card-body">
                <label asp-for="DocumentFile" class="form-label">Document File</label>
                <input asp-for="DocumentFile" type="file" class="form-control" required />
                <span asp-validation-for="DocumentFile" class="text-danger small"></span>
                <div class="form-text">Select the file to attach to this document request.</div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Submit Document Request</button>
            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>