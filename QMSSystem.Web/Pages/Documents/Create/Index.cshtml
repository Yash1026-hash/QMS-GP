@page
@model QMS.Pages.Documents.CreateModel

@{
    ViewData["Title"] = "Create Document";
}

<div class="container mt-4">

    <h2>Create Document</h2>

    <p class="text-muted">
        Create a new controlled document.
    </p>

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Document Title -->
        <div class="mb-3">
            <label asp-for="Document.Title" class="form-label">
                Document Title
            </label>

            <input asp-for="Document.Title"
                   class="form-control"
                   placeholder="Enter document title" />

            <span asp-validation-for="Document.Title"
                  class="text-danger">
            </span>
        </div>

        <!-- Department -->
        <div class="mb-3">
            <label asp-for="Document.Department"
                   class="form-label">
                Department
            </label>

            <select asp-for="Document.Department"
                    class="form-select">

                <option value="">Select Department</option>
                <option value="HR">HR</option>
                <option value="Finance">Finance</option>
                <option value="IT">IT</option>
                <option value="Quality">Quality</option>
                <option value="Operations">Operations</option>

            </select>

            <span asp-validation-for="Document.Department"
                  class="text-danger">
            </span>
        </div>

        <!-- Buttons -->
        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Create Document
            </button>

            <a asp-page="Index"
               class="btn btn-secondary ms-2">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}