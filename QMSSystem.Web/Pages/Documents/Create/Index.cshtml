@page
@model QMS.Pages.Documents.CreateModel

@{
    ViewData["Title"] = "Create Document";
}

<h2>Create Document</h2>

<form method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Document.DocumentNumber"></label>
        <input asp-for="Document.DocumentNumber" />
        <span asp-validation-for="Document.DocumentNumber"></span>
    </div>

    <div>
        <label asp-for="Document.Title"></label>
        <input asp-for="Document.Title" />
        <span asp-validation-for="Document.Title"></span>
    </div>

    <div>
        <label asp-for="Document.Department"></label>
        <input asp-for="Document.Department" />
        <span asp-validation-for="Document.Department"></span>
    </div>

    <div>
        <label>Document File</label>
        <input type="file"
               asp-for="DocumentFile"
               accept=".pdf,.doc,.docx" />
    </div>

    <div>
        <label asp-for="Comment"></label>
        <textarea asp-for="Comment"></textarea>
        <span asp-validation-for="Comment"></span>
    </div>

    <button type="submit">Submit</button>

</form>