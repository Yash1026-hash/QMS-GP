 @page "{id:int}"
 @model QMSSystem.Web.Pages.Documents.UploadRevision.IndexModel
@{
    ViewData["Title"] = "Upload New Revision";
}

<div class="container py-4" style="max-width: 760px">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / DOCUMENT CONTROL</p>
            <h1 class="h3 mb-1">Upload New Revision</h1>
            <p class="text-muted mb-0">
                <code>@Model.Document.DocumentNumber</code> &bull; @Model.Document.Title &bull;
                @Model.Document.Department &bull; current v@Model.Document.DocumentVersion
            </p>
        </div>
        <a asp-page="/Documents/Index" class="btn btn-outline-secondary">&larr; Back to Documents</a>
    </div>

    <div class="alert alert-info mb-4">
        Document number, title, and department are editable. Version and status are managed by QMS.
        Uploading a new file will:
        <ul class="mb-0 mt-1">
            <li>Archive the current version (v@Model.Document.DocumentVersion) in document history</li>
            <li>Replace the active file and increase the version to v@(Model.Document.DocumentVersion + 1)</li>
        </ul>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <span class="fw-semibold">Current File</span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Document.FileName))
            {
                <div class="fw-semibold mb-2">@Model.Document.FileName</div>
                <a asp-page-handler="CurrentFile"
                   asp-route-id="@Model.Document.Id"
                   class="btn btn-sm btn-outline-primary">
                    Download Current File (v@Model.Document.DocumentVersion)
                </a>
            }
            else
            {
                <p class="text-muted mb-0">No current file is attached.</p>
            }
        </div>
    </div>

    <form method="post" id="uploadRevisionForm" enctype="multipart/form-data" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <span class="fw-semibold">Revision Information</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="DocumentNumber" class="form-label fw-semibold">Document Number <span class="text-danger">*</span></label>
                    <input asp-for="DocumentNumber" class="form-control" required />
                    <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Department" class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                    <input asp-for="Department" class="form-control" required />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UploadFile" class="form-label fw-semibold">New Revision File <span class="text-danger">*</span></label>
                    <input asp-for="UploadFile" type="file" class="form-control" required />
                    <span asp-validation-for="UploadFile" class="text-danger small"></span>
                </div>

                <div class="mb-0">
                    <label asp-for="Comment" class="form-label fw-semibold">Change Description</label>
                    <textarea asp-for="Comment" class="form-control" rows="3"
                              placeholder="What changed in this revision?"></textarea>
                    <span asp-validation-for="Comment" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-page="/Documents/Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" id="uploadRevisionSubmitBtn" class="btn btn-primary">Upload Revision</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var $revisionForm = $("#uploadRevisionForm");
            if ($revisionForm.length) {
                $revisionForm.validate({
                    rules: {
                        DocumentNumber: {
                            required: true,
                            minlength: 3,
                            maxlength: 50
                        },
                        Title: {
                            required: true,
                            minlength: 3,
                            maxlength: 200
                        },
                        Department: {
                            required: true,
                            minlength: 2,
                            maxlength: 100
                        },
                        UploadFile: {
                            required: true
                        },
                        Comment: {
                            maxlength: 1000
                        }
                    },
                    messages: {
                        DocumentNumber: {
                            required: "Please enter the document number.",
                            minlength: "Document number must be at least 3 characters.",
                            maxlength: "Document number cannot exceed 50 characters."
                        },
                        Title: {
                            required: "Please enter the document title.",
                            minlength: "Title must be at least 3 characters.",
                            maxlength: "Title cannot exceed 200 characters."
                        },
                        Department: {
                            required: "Please enter the department.",
                            minlength: "Department must be at least 2 characters.",
                            maxlength: "Department cannot exceed 100 characters."
                        },
                        UploadFile: {
                            required: "Please select a replacement file to upload."
                        },
                        Comment: {
                            maxlength: "Change description cannot exceed 1000 characters."
                        }
                    },
                    submitHandler: function (form) {
                        $("#uploadRevisionSubmitBtn").prop("disabled", true).text("Uploading...");
                        form.submit();
                    }
                });
            }
        });
    </script>
}