@page "{id:int}"
@model QMSSystem.Web.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = "Document details";
    var document = Model.Document!;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-muted mb-1">Controlled documents</p>
            <h1 class="h2 mb-1">@document.DocumentNumber</h1>
            <p class="text-muted mb-0">@document.Title</p>
        </div>
        <div class="d-flex gap-2">
            @if (document.Status == "Revision Required" || document.Status == "Returned for revision" || document.Decision == 3)
            {
                <a asp-page="/Documents/UploadRevision/Index"
                   asp-route-id="@document.Id"
                   class="btn btn-primary">
                    Upload Revision
                </a>
            }
            <a asp-page="/Documents/Index" class="btn btn-outline-secondary">Back to documents</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light fw-semibold">Document information</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Document number</dt>
                <dd class="col-sm-9">@document.DocumentNumber</dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@document.Title</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@document.Department</dd>

                <dt class="col-sm-3">Version</dt>
                <dd class="col-sm-9">@document.DocumentVersion</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(document.Status switch {
                        "Active" or "Approved" => "bg-success",
                        "Pending" => "bg-warning text-dark",
                        "Revision Required" or "Returned for revision" => "bg-warning text-dark",
                        "Rejected" => "bg-danger",
                        _ => "bg-secondary"
                    })">
                        @(document.Status == "Active" ? "Approved" : document.Status)
                    </span>
                </dd>

                <dt class="col-sm-3">Current file</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(document.FileName))
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-semibold">@document.FileName</span>
                            <a asp-page-handler="Preview"
                               asp-route-id="@document.Id"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary">
                                Preview Document
                            </a>
                            <a asp-page-handler="Download"
                               asp-route-id="@document.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Download
                            </a>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No file attached</span>
                    }
                </dd>

                @if (!string.IsNullOrWhiteSpace(document.Comment))
                {
                    <dt class="col-sm-3">Change description</dt>
                    <dd class="col-sm-9">@document.Comment</dd>
                }
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light fw-semibold">Event information</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Created by</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(document.CreatedByName)
                        ? $"User #{document.CreatedBy}"
                        : document.CreatedByName)
                </dd>

                <dt class="col-sm-3">Created on</dt>
                <dd class="col-sm-9">@document.CreationOn.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</dd>

                <dt class="col-sm-3">Decision</dt>
                <dd class="col-sm-9">
                    @switch (document.Decision)
                    {
                        case 1:
                            <span class="badge bg-success">Approved</span>
                            break;
                        case 2:
                            <span class="badge bg-danger">Rejected</span>
                            break;
                        case 3:
                            <span class="badge bg-warning text-dark">Returned for Revision</span>
                            break;
                        case null:
                            <span class="text-muted">-</span>
                            break;
                        default:
                            @document.Decision
                            break;
                    }
                </dd>

                <dt class="col-sm-3">Decision by</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(document.DecisionBy) ? "-" : document.DecisionBy)</dd>

                <dt class="col-sm-3">Decision date</dt>
                <dd class="col-sm-9">@(document.DecisionDate?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "-")</dd>
            </dl>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-light fw-semibold">Version history</div>
        <div class="card-body">
            @if (Model.HistoryLoadFailed)
            {
                <div class="alert alert-warning mb-0" role="alert">
                    Version history could not be loaded. Please try again later.
                </div>
            }
            else if (Model.History.Count == 0)
            {
                <p class="text-muted mb-0">No previous versions have been archived.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Version</th>
                                <th scope="col">Status</th>
                                <th scope="col">File</th>
                                <th scope="col">Archived on</th>
                                <th scope="col">Change description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var version in Model.History)
                            {
                                <tr>
                                    <td>@version.DocumentVersion</td>
                                    <td>@version.Status</td>
                                    <td>@version.FileName</td>
                                    <td>@version.ArchivedOn.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(version.Comment) ? "-" : version.Comment)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>