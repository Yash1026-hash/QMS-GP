@page
@model QMS.Pages.Documents.DetailsModel

@{
    ViewData["Title"] = "Document Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Document Details</h2>
            <p class="text-muted">
                View document information and revision history.
            </p>
        </div>

        <a asp-page="Index" class="btn btn-secondary">
            Back to Documents
        </a>
    </div>


    <!-- Document Information -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Document Information</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-6">
                    <strong>Document Number</strong>
                    <p class="mb-0">
                        @Model.Document.DocumentNumber
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Document Title</strong>
                    <p class="mb-0">
                        @Model.Document.Title
                    </p>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6">
                    <strong>Department</strong>
                    <p class="mb-0">
                        @Model.Document.Department
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Status</strong>
                    <p class="mb-0">
                        <span class="badge bg-warning text-dark">
                            Pending Approval
                        </span>
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- Approval -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Approval</h5>
        </div>

        <div class="card-body">

            <p class="text-muted mb-3">
                This document is waiting for supervisor approval.
            </p>

            <button class="btn btn-success">
                Approve
            </button>

            <button class="btn btn-danger ms-2">
                Reject
            </button>

        </div>

    </div>


    <!-- Revision History -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Revision History</h5>
        </div>

        <div class="card-body">

            <p class="text-muted">
                No revisions uploaded yet.
            </p>

            <a asp-page="UploadRevision"
               asp-route-id="@Model.Document.Id"
               class="btn btn-primary">

                Upload Revision

            </a>

        </div>

    </div>

</div>