@page "/documents/documentapproval"
@model QMSSystem.Web.Pages.Documents.ApprovalModel
@{
    ViewData["Title"] = "Document Approval";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Document Control Approval</h1>
        <p class="text-body-secondary mb-0">Select a document to review its approval details.</p>
    </div>

    <div class="card">
        <div class="card-header bg-body py-3">
            <h2 class="h5 mb-0">Documents awaiting approval</h2>
        </div>
        <div class="table-responsive">
            <table id="documentApprovalTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Request ID</th>
                        <th scope="col">Document</th>
                        <th scope="col">Document ID</th>
                        <th scope="col">Revision</th>
                        <th scope="col">Requested by</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-semibold">DCR-2026-014</td>
                        <td>Equipment Calibration Procedure</td>
                        <td>SOP-QA-042</td>
                        <td>03 → 04</td>
                        <td>Maya Patel</td>
                        <td><span class="badge text-bg-warning">Pending</span></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#documentApprovalModal">
                                View
                            </button>
                        </td>
                    </tr>
                    
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <small id="paginationSummary" class="text-body-secondary" aria-live="polite"></small>
            <nav aria-label="Document table pagination">
                <ul id="documentApprovalPagination" class="pagination pagination-sm mb-0"></ul>
            </nav>
        </div>
    </div>
</div>

<div class="modal fade" id="documentApprovalModal" tabindex="-1" aria-labelledby="documentApprovalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="small text-body-secondary">DCR-2026-014 · SOP-QA-042</div>
                    <h2 class="modal-title fs-5" id="documentApprovalModalLabel">Equipment Calibration Procedure</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="approvalValidationMessage" class="alert alert-success d-none" role="status">
                    Approval details are valid. Saving approval decisions is not connected yet.
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="small text-body-secondary">Current revision</div>
                        <div class="fw-semibold">Rev. 03</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-body-secondary">Requested revision</div>
                        <div class="fw-semibold">Rev. 04</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-body-secondary">Requested by</div>
                        <div class="fw-semibold">Maya Patel</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-body-secondary">Department</div>
                        <div class="fw-semibold">Quality Assurance</div>
                    </div>
                </div>
                <h3 class="h6">Change summary</h3>
                <p>Update calibration frequency guidance and clarify the required instrument status checks before use.</p>
                <h3 class="h6">Justification</h3>
                <p class="mb-4">This revision aligns the procedure with the current equipment risk assessment and recent audit observations.</p>
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Approval decision</legend>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="decision014" id="approve014" value="approve" required>
                            <label class="form-check-label" for="approve014">Approve</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="decision014" id="revision014" value="revision">
                            <label class="form-check-label" for="revision014">Return for revision</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="decision014" id="reject014" value="reject">
                            <label class="form-check-label" for="reject014">Reject</label>
                        </div>
                    </div>
                    <div id="decision014Feedback" class="invalid-feedback" aria-live="polite">
                        Select a decision before continuing.
                    </div>
                </fieldset>
                <div>
                    <label class="form-label" for="comments014">Reviewer comments</label>
                    <textarea class="form-control" id="comments014" rows="3" aria-describedby="comments014Feedback" placeholder="Enter comments for the requester" required></textarea>
                    <div id="comments014Feedback" class="invalid-feedback" aria-live="polite">
                        Reviewer comments are required for every approval decision.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="submitApproval">Submit</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            const rowsPerPage = 10;
            const $rows = $('#documentApprovalTable tbody tr');
            const $pagination = $('#documentApprovalPagination');
            const $summary = $('#paginationSummary');
            const totalRows = $rows.length;
            const totalPages = Math.ceil(totalRows / rowsPerPage);
            let currentPage = 1;

            const $decisionInputs = $('input[name="decision014"]');
            const $decisionFeedback = $('#decision014Feedback');
            const $comments = $('#comments014');
            const $commentsFeedback = $('#comments014Feedback');
            const $approvalModal = $('#documentApprovalModal');
            const $approvalValidationMessage = $('#approvalValidationMessage');

            function clearApprovalValidation() {
                $approvalValidationMessage.addClass('d-none');
                $decisionInputs.removeClass('is-invalid');
                $decisionFeedback
                    .text('Select a decision before continuing.')
                    .removeClass('d-block');
                $comments
                    .removeClass('is-invalid')
                    .removeAttr('aria-invalid aria-required');
                $commentsFeedback.removeClass('d-block');
            }

            $approvalModal.on('hidden.bs.modal', clearApprovalValidation);
            $approvalModal.on('show.bs.modal', function () {
                clearApprovalValidation();
                $decisionInputs.prop('checked', false);
                $comments.val('');
            });

            $decisionInputs.on('change', clearApprovalValidation);

            $comments.on('input', function () {
                if (($comments.val() || '').trim()) {
                    $comments
                        .removeClass('is-invalid')
                        .removeAttr('aria-invalid');
                    $commentsFeedback.removeClass('d-block');
                }
            });

            $('#submitApproval').on('click', function () {
                clearApprovalValidation();

                const selectedDecision = $('input[name="decision014"]:checked').val();
                const commentsValue = ($comments.val() || '').trim();
                let isValid = true;

                if (!selectedDecision) {
                    $decisionInputs.addClass('is-invalid');
                    $decisionFeedback.addClass('d-block');
                    isValid = false;
                }

                if (!commentsValue) {
                    $comments
                        .addClass('is-invalid')
                        .attr('aria-invalid', 'true');
                    $commentsFeedback.addClass('d-block');
                    isValid = false;
                }

                if (!isValid) {
                    $('#documentApprovalModal .is-invalid').first().trigger('focus');
                    return;
                }

                $approvalValidationMessage.removeClass('d-none');
            });

            function showPage(page) {
                currentPage = Math.min(Math.max(page, 1), totalPages || 1);

                const startIndex = (currentPage - 1) * rowsPerPage;
                $rows.hide().slice(startIndex, startIndex + rowsPerPage).show();
                $pagination.empty();

                function addPageItem(label, page, disabled, active, ariaLabel) {
                    const $item = $('<li>').addClass('page-item');
                    if (disabled) {
                        $item.addClass('disabled');
                    }
                    if (active) {
                        $item.addClass('active');
                    }

                    const $button = $('<button>')
                        .addClass('page-link')
                        .attr('type', 'button')
                        .attr('aria-label', ariaLabel || label)
                        .text(label);

                    if (active) {
                        $button.attr('aria-current', 'page');
                    }
                    if (disabled) {
                        $button.attr('disabled', 'disabled');
                    } else {
                        $button.on('click', function () {
                            showPage(page);
                        });
                    }

                    $item.append($button);
                    $pagination.append($item);
                }

                addPageItem('Previous', currentPage - 1, currentPage === 1, false, 'Go to previous page');

                for (let page = 1; page <= totalPages; page++) {
                    addPageItem(String(page), page, false, page === currentPage, `Go to page ${page}`);
                }

                addPageItem('Next', currentPage + 1, currentPage === totalPages || totalPages === 0, false, 'Go to next page');

                const firstRow = totalRows === 0 ? 0 : startIndex + 1;
                const lastRow = Math.min(startIndex + rowsPerPage, totalRows);
                $summary.text(`Showing ${firstRow} to ${lastRow} of ${totalRows} documents`);
            }

            showPage(currentPage);
        });
    </script>
}