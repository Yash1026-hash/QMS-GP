@page "/documents/documentapproval"
@model QMSSystem.Web.Pages.Documents.ApprovalModel
@{
    ViewData["Title"] = "Document Approval";
}

<div class="container py-4">
    <div class="mb-4">
        <p class="eyebrow mb-2">QMS / DOCUMENT CONTROL</p>
        <h1 class="h3 mb-1">Document Approval</h1>
        <p class="text-muted mb-0">Review pending documents and record your decision.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Documents.Count == 0 && string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-info" role="status">There are no documents waiting for review.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var document in Model.Documents)
            {
                <section class="card" aria-labelledby="document-@document.Id-title">
                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-semibold">@document.DocumentNumber</span>
                            <span class="text-muted"> · @document.Title</span>
                        </div>
                        <span class="badge @(document.Status.Equals("Returned", StringComparison.OrdinalIgnoreCase) ? "text-bg-info" : "text-bg-warning")">
                            @document.Status
                        </span>
                    </div>
                    <div class="card-body">
                        <h2 id="document-@document.Id-title" class="h5">@document.Title</h2>
                        <dl class="row mb-4">
                            <dt class="col-sm-3">Department</dt>
                            <dd class="col-sm-9">@document.Department</dd>
                            <dt class="col-sm-3">Submitted by</dt>
                            <dd class="col-sm-9">
                                @(string.IsNullOrWhiteSpace(document.CreatedByName)
                                    ? $"User #{document.CreatedBy}"
                                    : document.CreatedByName)
                            </dd>
                            <dt class="col-sm-3">Submitted</dt>
                            <dd class="col-sm-9">@document.CreationOn.ToLocalTime().ToString("g")</dd>
                            @if (!string.IsNullOrWhiteSpace(document.Comment))
                            {
                                <dt class="col-sm-3">Request comment</dt>
                                <dd class="col-sm-9">@document.Comment</dd>
                            }
                        </dl>

                        <form method="post" asp-page-handler="Decide">
                            <input type="hidden" name="documentId" value="@document.Id" />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label" for="decision-@document.Id">Decision</label>
                                    <select class="form-select" id="decision-@document.Id" name="decision" required>
                                        <option value="">Choose a decision</option>
                                        <option value="Approve">Approve and activate</option>
                                        <option value="Return">Return for changes</option>
                                        <option value="Reject">Reject</option>
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label" for="comment-@document.Id">Reviewer comment</label>
                                    <textarea class="form-control" id="comment-@document.Id" name="comment"
                                              rows="2" maxlength="2000" required></textarea>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="submit" class="btn btn-primary">Record Decision</button>
                                <a asp-page="/Documents/Details/Index" asp-route-id="@document.Id"
                                   class="btn btn-outline-secondary">View Details</a>
                            </div>
                        </form>
                    </div>
                </section>
            }
        </div>
    }
</div>
