@page
@model QMSSystem.Web.Pages.Documents.IndexModel

@{
    ViewData["Title"] = "Documents";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Documents</h2>
            <p class="text-muted">View and manage controlled documents.</p>
        </div>

        <a asp-page="/Documents/Create" class="btn btn-primary">
            Create Document
        </a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-5 col-lg-4">
            <label asp-for="SearchQuery" class="form-label">Search documents</label>
            <input asp-for="SearchQuery"
                   class="form-control"
                   placeholder="Document number, title, department, or status" />
        </div>
        <div class="col-md-3 col-lg-2">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) ||
                 !string.IsNullOrWhiteSpace(Model.StatusFilter))
            {
                <a asp-page="/Documents/Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (Model.Documents.Count == 0)
    {
        <div class="alert alert-info">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) &&
              string.IsNullOrWhiteSpace(Model.StatusFilter)
                ? "No documents found."
                : "No documents match the selected filters.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Document Number</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Version</th>
                        <th>Status</th>
                        <th>Created On</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>@document.DocumentNumber</td>

                            <td>@document.Title</td>

                            <td>@document.Department</td>

                            <td>@document.DocumentVersion</td>

                            <td>
                                @document.Status
                            </td>

                            <td>
                                @document.CreationOn.ToString("dd-MM-yyyy")
                            </td>

                            <td class="text-nowrap">
                                <div class="d-flex flex-wrap gap-2">
                                <a asp-page="/Documents/Details/Index"
                                   asp-route-id="@document.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                @if (document.Status == "Active")
                                {
                                    <a asp-page="/Documents/UploadRevision/Index"
                                       asp-route-id="@document.Id"
                                       class="btn btn-sm btn-outline-warning">
                                       EDIT
                                       
                                    </a>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>