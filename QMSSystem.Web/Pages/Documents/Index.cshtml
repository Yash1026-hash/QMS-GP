@page
@model QMSSystem.Web.Pages.Documents.IndexModel

@{
    ViewData["Title"] = "Documents";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / DOCUMENTS</p>
            <h1 class="h3 mb-1">Controlled Documents</h1>
            <p class="text-muted mb-0">View and manage controlled documents across departments.</p>
        </div>

        <a asp-page="/Documents/Create" class="btn btn-primary">
            + Create Document
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" id="documentsFilterForm" class="row g-2 align-items-end">
                <div class="col-md-5 col-lg-4">
                    <label asp-for="SearchQuery" class="form-label">Search documents</label>
                    <input asp-for="SearchQuery"
                           id="documentsSearchQuery"
                           class="form-control"
                           maxlength="100"
                           placeholder="Document number, title, department..." />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label asp-for="StatusFilter" class="form-label">Status</label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) ||
                         !string.IsNullOrWhiteSpace(Model.StatusFilter))
                    {
                        <a asp-page="/Documents/Index" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.Documents.Count == 0)
    {
        <div class="alert alert-info">
            @(string.IsNullOrWhiteSpace(Model.SearchQuery) &&
              string.IsNullOrWhiteSpace(Model.StatusFilter)
                ? "No documents found."
                : "No documents match the selected filters.")
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Document Register</span>
                <span class="badge bg-secondary">Total: @Model.Documents.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 140px;">Document #</th>
                                <th>Title</th>
                                <th>Department</th>
                                <th style="width: 90px;">Version</th>
                                <th style="width: 100px;">Status</th>
                                <th style="width: 120px;">Created On</th>
                                <th style="width: 160px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in Model.Documents)
                            {
                                <tr>
                                    <td class="fw-semibold">@document.DocumentNumber</td>
                                    <td>@document.Title</td>
                                    <td>@document.Department</td>
                                    <td>v@document.DocumentVersion</td>
                                    <td>
                                        <span class="badge @(document.Status == "Active" ? "bg-success" : "bg-secondary")">
                                            @document.Status
                                        </span>
                                    </td>
                                    <td>@document.CreationOn.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-page="/Documents/Details/Index"
                                               asp-route-id="@document.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                            @if (document.Status == "Active")
                                            {
                                                <a asp-page="/Documents/UploadRevision/Index"
                                                   asp-route-id="@document.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Edit Revision
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#documentsFilterForm").on("submit", function () {
                var $q = $("#documentsSearchQuery");
                if ($q.val().length > 100) {
                    $q.val($q.val().substring(0, 100));
                }
            });
        });
    </script>
}