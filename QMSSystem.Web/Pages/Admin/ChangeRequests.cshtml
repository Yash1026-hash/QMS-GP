@page
@model QMSSystem.Web.Pages.Admin.ChangeRequestsModel
@{
    ViewData["Title"] = "Change requests";
    ViewData["AdminSection"] = "ChangeRequests";
}

<partial name="_AdminNavigation" />

<section class="admin-page">
    <div class="admin-page-heading">
        <div>
            <p class="eyebrow">Workflow oversight</p>
            <h1>Change requests</h1>
            <p class="admin-page-description">View change requests across all users and follow their linked deviation, report, and document.</p>
        </div>
    </div>

    <div class="admin-filter-bar" aria-label="Change request filters">
        <span class="admin-filter-label">Status</span>
        <button class="admin-filter-chip active" type="button" aria-pressed="true">All</button>
        <button class="admin-filter-chip" type="button" disabled>Draft</button>
        <button class="admin-filter-chip" type="button" disabled>Submitted</button>
        <button class="admin-filter-chip" type="button" disabled>Approved</button>
        <button class="admin-filter-chip" type="button" disabled>Rejected</button>
        <span class="admin-filter-note">Filters will be enabled when the admin API is connected.</span>
    </div>

    <div class="admin-table-card">
        <div class="admin-table-heading">
            <div>
                <h2>All change requests</h2>
                <p>Read-only oversight; request decisions remain with the supervisor workflow.</p>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Request</th>
                        <th scope="col">Document</th>
                        <th scope="col">Deviation</th>
                        <th scope="col">Report</th>
                        <th scope="col">Type</th>
                        <th scope="col">Requested by</th>
                        <th scope="col">Date</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="8" class="admin-empty-state">
                            <strong>No change requests loaded</strong>
                            <span>Requests from the shared workflow will appear here.</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
