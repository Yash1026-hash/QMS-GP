@page
@model QMSSystem.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Dashboard</h2>
        <p class="text-muted mb-0">System overview across documents, deviations, and change requests.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Admin/DocumentRegister/Index" class="btn btn-outline-secondary btn-sm">Documents</a>
        <a asp-page="/Admin/Deviations/Index" class="btn btn-outline-secondary btn-sm">Deviations</a>
        <a asp-page="/Admin/ChangeRequests/Index" class="btn btn-outline-secondary btn-sm">Change Requests</a>
    </div>
</div>

<!-- Summary Cards (Standard default layout) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Total Deviations</div>
                <div class="h4 mb-0 mt-1">@Model.TotalDeviations</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Controlled Documents</div>
                <div class="h4 mb-0 mt-1">@Model.TotalDocuments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Change Requests</div>
                <div class="h4 mb-0 mt-1">@Model.TotalChangeRequests</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Pending Deviations</div>
                <div class="h4 mb-0 mt-1">@Model.PendingDeviations</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Overview Sections -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Recent Deviations</span>
                <a asp-page="/Admin/Deviations/Index" class="small text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentDeviations.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        No deviation records available.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dev in Model.RecentDeviations)
                                {
                                    <tr>
                                        <td>#DEV-@dev.Id</td>
                                        <td>@dev.Title</td>
                                        <td>@dev.Priority</td>
                                        <td>@(dev.Status switch { 0 => "Pending", 1 => "Active", _ => "Inactive" })</td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/Deviations/Details" asp-route-id="@dev.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Recent Change Requests</span>
                <a asp-page="/Admin/ChangeRequests/Index" class="small text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentChangeRequests.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        No change request records available.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cr in Model.RecentChangeRequests)
                                {
                                    <tr>
                                        <td>#CR-@cr.Id</td>
                                        <td>@cr.Title</td>
                                        <td>@cr.ChangeType</td>
                                        <td>@cr.Status</td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/ChangeRequests/Details" asp-route-id="@cr.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
