@page
@model QMSSystem.Web.Pages.Admin.AuditTrailModel
@{
    ViewData["Title"] = "Document Audit Trail";
    ViewData["ActivePage"] = "AuditTrail";

    var firstRow = Model.FilteredCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var lastRow = Math.Min(Model.PageNumber * Model.PageSize, Model.FilteredCount);
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Document Audit Trail</h2>
        <p class="text-muted mb-0">Complete historical revision logs and document archiving records.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="auditTrailFilterForm" class="row g-2 align-items-end" novalidate>
            <input type="hidden" name="PageNumber" value="1" />
            <div class="col-md-6">
                <label class="form-label small">Search</label>
                <input type="text" name="SearchQuery" id="auditSearchInput" value="@Model.SearchQuery" class="form-control" placeholder="Search document number, title, comment..." maxlength="100" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Department</label>
                <input type="text" name="DepartmentFilter" id="auditDeptInput" value="@Model.DepartmentFilter" class="form-control" placeholder="Filter by department..." maxlength="100" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="/Admin/AuditTrail" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Trail Table -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold">Historical Audit Log Entries</span>
        <span class="badge bg-secondary">
            @if (Model.FilteredCount == Model.TotalRecords)
            {
                <span>@Model.TotalRecords Total</span>
            }
            else
            {
                <span>@Model.FilteredCount of @Model.TotalRecords</span>
            }
        </span>
    </div>
    <div class="card-body p-0">
        @if (Model.AuditRecords.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No archived document history records found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Archived Date</th>
                            <th>Doc Number</th>
                            <th>Ver</th>
                            <th>Title</th>
                            <th>Department</th>
                            <th>Archived By</th>
                            <th>Status</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.AuditRecords)
                        {
                            <tr>
                                <td>@record.ArchivedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-page="/Admin/DocumentRegister/Details" asp-route-id="@record.DocumentId" class="fw-semibold text-decoration-none">
                                        @record.DocumentNumber
                                    </a>
                                </td>
                                <td><span class="badge bg-light text-dark border">v@(record.DocumentVersion)</span></td>
                                <td>@record.Title</td>
                                <td>@record.Department</td>
                                <td>User #@record.ArchivedBy</td>
                                <td>
                                    <span class="badge @(record.Status switch {
                                        "Active" or "Approved" => "bg-success",
                                        "Pending" => "bg-warning text-dark",
                                        "Revision Required" => "bg-warning text-dark",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    })">@record.Status</span>
                                </td>
                                <td class="small">@(string.IsNullOrWhiteSpace(record.Comment) ? "-" : record.Comment)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.FilteredCount > 0)
    {
        <div class="card-footer bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
            <small class="text-muted">
                Showing @firstRow to @lastRow of @Model.FilteredCount entries
                @if (Model.FilteredCount != Model.TotalRecords)
                {
                    <span>(filtered from @Model.TotalRecords total)</span>
                }
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Audit trail table pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- First & Previous -->
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/AuditTrail"
                               asp-route-PageNumber="1"
                               asp-route-SearchQuery="@Model.SearchQuery"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               aria-label="First page">&laquo;</a>
                        </li>
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/AuditTrail"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-SearchQuery="@Model.SearchQuery"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               aria-label="Previous page">Previous</a>
                        </li>

                        <!-- Numbered page links -->
                        @for (var p = firstPage; p <= lastPage; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-page="/Admin/AuditTrail"
                                   asp-route-PageNumber="@p"
                                   asp-route-SearchQuery="@Model.SearchQuery"
                                   asp-route-DepartmentFilter="@Model.DepartmentFilter">@p</a>
                            </li>
                        }

                        <!-- Next & Last -->
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/AuditTrail"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-SearchQuery="@Model.SearchQuery"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               aria-label="Next page">Next</a>
                        </li>
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="/Admin/AuditTrail"
                               asp-route-PageNumber="@Model.TotalPages"
                               asp-route-SearchQuery="@Model.SearchQuery"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               aria-label="Last page">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("#auditTrailFilterForm").validate({
                errorElement: "span",
                errorClass: "invalid-feedback d-block",
                highlight: function (element) {
                    $(element).addClass("is-invalid").removeClass("is-valid");
                },
                unhighlight: function (element) {
                    $(element).removeClass("is-invalid is-valid");
                },
                rules: {
                    SearchQuery: {
                        maxlength: 100
                    },
                    DepartmentFilter: {
                        maxlength: 100
                    }
                },
                messages: {
                    SearchQuery: {
                        maxlength: "Search query cannot exceed 100 characters."
                    },
                    DepartmentFilter: {
                        maxlength: "Department filter cannot exceed 100 characters."
                    }
                }
            });
        });
    </script>
}
