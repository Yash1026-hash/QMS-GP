@page
@model QMSSystem.Web.Pages.Admin.Deviations.IndexModel
@{
    ViewData["Title"] = "Deviations";
    ViewData["ActivePage"] = "Deviations";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Deviations</h2>
        <p class="text-muted mb-0">List of all recorded deviations.</p>
    </div>
</div>

<!-- Filters Bar (Standard default controls) -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search</label>
                <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All</option>
                    <option value="0" selected="@(Model.StatusFilter == 0)">Pending (0)</option>
                    <option value="1" selected="@(Model.StatusFilter == 1)">Active (1)</option>
                    <option value="2" selected="@(Model.StatusFilter == 2)">Inactive (2)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Priority</label>
                <select name="PriorityFilter" class="form-select">
                    <option value="">All</option>
                    <option value="Minor" selected="@(Model.PriorityFilter == "Minor")">Minor</option>
                    <option value="Major" selected="@(Model.PriorityFilter == "Major")">Major</option>
                    <option value="Critical" selected="@(Model.PriorityFilter == "Critical")">Critical</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Decision</label>
                <select name="DecisionFilter" class="form-select">
                    <option value="">All</option>
                    <option value="1" selected="@(Model.DecisionFilter == 1)">Approved (1)</option>
                    <option value="2" selected="@(Model.DecisionFilter == 2)">Rejected (2)</option>
                    <option value="-1" selected="@(Model.DecisionFilter == -1)">Pending</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="/Admin/Deviations/Index" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Deviations Table -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <span class="fw-semibold">Records (@Model.Deviations.Count)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Deviations.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No deviation records found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Document ID</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Decision</th>
                            <th>Decision By</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dev in Model.Deviations)
                        {
                            <tr>
                                <td>@dev.Id</td>
                                <td>
                                    <div class="fw-semibold">@dev.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 300px;">@dev.Description</div>
                                </td>
                                <td>@dev.DocumentId</td>
                                <td>@dev.Priority</td>
                                <td>
                                    @(dev.Status switch { 0 => "Pending", 1 => "Active", _ => "Inactive" })
                                </td>
                                <td>
                                    @(dev.Decision switch { 1 => "Approved", 2 => "Rejected", _ => "Pending" })
                                </td>
                                <td>@dev.DecisionBy</td>
                                <td>@dev.CreatedBy</td>
                                <td>@dev.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-page="/Admin/Deviations/Details" asp-route-id="@dev.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
