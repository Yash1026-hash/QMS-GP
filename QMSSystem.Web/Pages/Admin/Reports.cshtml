@page
@model QMSSystem.Web.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Deviation Reports";
    ViewData["ActivePage"] = "DeviationReports";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Deviation Reports</h2>
        <p class="text-muted mb-0">Overview of all submitted deviation investigation reports and supervisory decisions.</p>
    </div>
    <div>
        <a asp-page="/Admin/Deviations/Index" class="btn btn-outline-secondary btn-sm">Back to Deviations</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Total Reports</div>
                <div class="h4 mb-0 mt-1">@Model.TotalReports</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Approved Reports</div>
                <div class="h4 mb-0 mt-1 text-success">@Model.ApprovedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Rejected Reports</div>
                <div class="h4 mb-0 mt-1 text-danger">@Model.RejectedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Pending Review</div>
                <div class="h4 mb-0 mt-1 text-warning">@Model.PendingCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Search</label>
                <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search summary, author, comments..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Decision</label>
                <select name="DecisionFilter" class="form-select">
                    <option value="">All Decisions</option>
                    <option value="-1" selected="@(Model.DecisionFilter == -1)">Pending Review</option>
                    <option value="1" selected="@(Model.DecisionFilter == 1)">Approved</option>
                    <option value="2" selected="@(Model.DecisionFilter == 2)">Rejected</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="0" selected="@(Model.StatusFilter == 0)">Pending (0)</option>
                    <option value="1" selected="@(Model.StatusFilter == 1)">Active (1)</option>
                    <option value="2" selected="@(Model.StatusFilter == 2)">Inactive (2)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="/Admin/Reports" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Reports Table -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <span class="fw-semibold">Deviation Reports Records (@Model.Reports.Count)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Reports.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No deviation report records found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>Deviation</th>
                            <th>Doc ID</th>
                            <th>Attempt</th>
                            <th>Summary</th>
                            <th>Submitted</th>
                            <th>Decision</th>
                            <th>Review Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr>
                                <td>#REP-@report.Id</td>
                                <td>
                                    <a asp-page="/Admin/Deviations/Details" asp-route-id="@report.DeviationId" class="fw-semibold text-decoration-none">
                                        #DEV-@report.DeviationId
                                    </a>
                                </td>
                                <td>
                                    <a asp-page="/Admin/DocumentRegister/Details" asp-route-id="@report.DocumentId" class="text-decoration-none">
                                        #DOC-@report.DocumentId
                                    </a>
                                </td>
                                <td><span class="badge bg-light text-dark border">#@report.AttemptNumber</span></td>
                                <td>@report.Summary</td>
                                <td>
                                    <div>@report.CreatedBy</div>
                                    <div class="small text-muted">@report.CreatedDate.ToString("yyyy-MM-dd")</div>
                                </td>
                                <td>
                                    @if (!report.Decision.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark">Under Review</span>
                                    }
                                    else if (report.Decision == 1)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                        @if (!string.IsNullOrWhiteSpace(report.DecisionBy))
                                        {
                                            <div class="small text-muted mt-1">by @report.DecisionBy</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                        @if (!string.IsNullOrWhiteSpace(report.DecisionBy))
                                        {
                                            <div class="small text-muted mt-1">by @report.DecisionBy</div>
                                        }
                                    }
                                </td>
                                <td class="small">
                                    @(string.IsNullOrWhiteSpace(report.DecisionComments) ? "-" : report.DecisionComments)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

