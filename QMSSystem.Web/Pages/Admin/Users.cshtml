@page
@model QMSSystem.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "User Management";
    ViewData["ActivePage"] = "Users";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">User & Role Management</h2>
        <p class="text-muted mb-0">View registered users, modify assigned security roles, and manage access status.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            + Add New User
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Total Registered Users</div>
                <div class="h4 mb-0 mt-1">@Model.TotalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Active Accounts</div>
                <div class="h4 mb-0 mt-1 text-success">@Model.ActiveUsers</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card h-100">
            <div class="card-body p-3">
                <div class="text-muted small">Pending Approval</div>
                <div class="h4 mb-0 mt-1 text-warning">@Model.PendingUsers</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="usersFilterForm" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Search</label>
                <input type="text" name="SearchQuery" id="userSearchInput" value="@Model.SearchQuery" class="form-control" placeholder="Search username, name, email..." maxlength="100" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Role</label>
                <select name="RoleFilter" id="userRoleFilter" class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role.Name" selected="@(Model.RoleFilter == role.Name)">@role.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Department</label>
                <input type="text" name="DepartmentFilter" id="userDepartmentFilter" value="@Model.DepartmentFilter" class="form-control" placeholder="Filter by department..." maxlength="100" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="/Admin/Users" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <span class="fw-semibold">System Users (@Model.Users.Count)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Users.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No user records found matching the specified filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>User Info</th>
                            <th>Department</th>
                            <th>Current Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th style="min-width: 250px;">Change Role / Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>#USR-@user.UserId</td>
                                <td>
                                    <div class="fw-semibold">@user.FullName</div>
                                    <div class="small text-muted">@user.Username &bull; @user.Email</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(user.Department) ? "-" : user.Department)</td>
                                <td>
                                    <span class="badge @(user.Role switch {
                                        "Admin" => "bg-danger",
                                        "Supervisor" => "bg-warning text-dark",
                                        "Operator" => "bg-primary",
                                        _ => "bg-secondary"
                                    })">@user.Role</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    <span class="small text-muted d-block mt-1">@user.RegistrationStatus</span>
                                </td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="d-flex flex-column gap-2">
                                        <!-- Role change form -->
                                        <form method="post" asp-page-handler="ChangeRole" class="d-flex gap-1 align-items-center change-role-form">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <select name="newRole" class="form-select form-select-sm" style="width: 130px;">
                                                @foreach (var role in Model.AvailableRoles)
                                                {
                                                    <option value="@role.Name" selected="@(user.Role == role.Name)">@role.Name</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                                                Update Role
                                            </button>
                                        </form>

                                        <!-- Status toggle form -->
                                        <form method="post" asp-page-handler="ToggleStatus" class="d-inline change-status-form">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <input type="hidden" name="isActive" value="@(!user.IsActive ? "true" : "false")" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-xs" onclick="return confirm('Are you sure you want to deactivate @user.Username?');">
                                                    Deactivate User
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success btn-xs" onclick="return confirm('Activate user account @user.Username?');">
                                                    Activate User
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add New User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateUser" id="addUserForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">Create New User Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewUser.Username" class="form-label fw-medium">Username <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.Username" class="form-control" placeholder="e.g. jdoe" required minlength="3" maxlength="50" autocomplete="username" />
                        <span asp-validation-for="NewUser.Username" class="invalid-feedback d-block"></span>
                        <div class="form-text small">3-50 characters. Letters, numbers, underscores, dots, or hyphens.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.FullName" class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.FullName" class="form-control" placeholder="e.g. John Doe" required minlength="2" maxlength="100" />
                        <span asp-validation-for="NewUser.FullName" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Email" class="form-label fw-medium">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.Email" type="email" class="form-control" placeholder="e.g. jdoe@example.com" required maxlength="150" />
                        <span asp-validation-for="NewUser.Email" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Password" class="form-label fw-medium">Password <span class="text-danger">*</span></label>
                        <input asp-for="NewUser.Password" type="password" class="form-control" placeholder="At least 6 characters" required minlength="6" maxlength="100" autocomplete="new-password" />
                        <span asp-validation-for="NewUser.Password" class="invalid-feedback d-block"></span>
                        <div class="form-text small">Minimum 6 characters.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Department" class="form-label fw-medium">Department</label>
                        <input asp-for="NewUser.Department" class="form-control" placeholder="e.g. Quality Assurance" maxlength="100" />
                        <span asp-validation-for="NewUser.Department" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUser.Role" class="form-label fw-medium">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="NewUser.Role" class="form-select" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        </select>
                        <span asp-validation-for="NewUser.Role" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="NewUser.IsActive" id="isActiveSwitch">
                        <label class="form-check-label" for="isActiveSwitch">Account Active Immediately</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="submitUserBtn" class="btn btn-primary">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            // Custom jQuery validation method for username characters
            $.validator.addMethod("usernameChars", function (value, element) {
                return this.optional(element) || /^[a-zA-Z0-9_.-]+$/.test(value);
            }, "Username can only contain letters, numbers, underscores, dots, or hyphens.");

            // jQuery Validation on Add User Form
            var $addUserForm = $("#addUserForm");
            if ($addUserForm.length) {
                $addUserForm.validate({
                    errorElement: "span",
                    errorClass: "invalid-feedback d-block",
                    highlight: function (element) {
                        $(element).addClass("is-invalid").removeClass("is-valid");
                    },
                    unhighlight: function (element) {
                        $(element).removeClass("is-invalid").addClass("is-valid");
                    },
                    rules: {
                        "NewUser.Username": {
                            required: true,
                            minlength: 3,
                            maxlength: 50,
                            usernameChars: true
                        },
                        "NewUser.FullName": {
                            required: true,
                            minlength: 2,
                            maxlength: 100
                        },
                        "NewUser.Email": {
                            required: true,
                            email: true,
                            maxlength: 150
                        },
                        "NewUser.Password": {
                            required: true,
                            minlength: 6,
                            maxlength: 100
                        },
                        "NewUser.Department": {
                            maxlength: 100
                        },
                        "NewUser.Role": {
                            required: true
                        }
                    },
                    messages: {
                        "NewUser.Username": {
                            required: "Please enter a username.",
                            minlength: "Username must be at least 3 characters.",
                            maxlength: "Username cannot exceed 50 characters."
                        },
                        "NewUser.FullName": {
                            required: "Please enter the full name.",
                            minlength: "Full name must be at least 2 characters.",
                            maxlength: "Full name cannot exceed 100 characters."
                        },
                        "NewUser.Email": {
                            required: "Please enter an email address.",
                            email: "Please enter a valid email address (e.g. user@example.com).",
                            maxlength: "Email cannot exceed 150 characters."
                        },
                        "NewUser.Password": {
                            required: "Please provide a password.",
                            minlength: "Password must be at least 6 characters.",
                            maxlength: "Password cannot exceed 100 characters."
                        },
                        "NewUser.Department": {
                            maxlength: "Department name cannot exceed 100 characters."
                        },
                        "NewUser.Role": {
                            required: "Please select an assigned role."
                        }
                    },
                    submitHandler: function (form) {
                        $("#submitUserBtn").prop("disabled", true).text("Creating...");
                        form.submit();
                    }
                });

                // Reset validation state when modal is closed
                $("#addUserModal").on("hidden.bs.modal", function () {
                    $addUserForm.validate().resetForm();
                    $addUserForm.find(".is-invalid, .is-valid").removeClass("is-invalid is-valid");
                    $("#submitUserBtn").prop("disabled", false).text("Create User");
                });
            }

            // jQuery validation for role change forms
            $(".change-role-form").on("submit", function (e) {
                var $select = $(this).find("select[name='newRole']");
                var selectedRole = $.trim($select.val());
                if (!selectedRole) {
                    e.preventDefault();
                    alert("Please select a valid role before submitting.");
                    $select.addClass("is-invalid").focus();
                    return false;
                }
                $select.removeClass("is-invalid");
                return true;
            });

            // jQuery validation for user filter form
            $("#usersFilterForm").on("submit", function () {
                var $search = $("#userSearchInput");
                var $dept = $("#userDepartmentFilter");
                if ($search.val().length > 100) {
                    $search.val($search.val().substring(0, 100));
                }
                if ($dept.val().length > 100) {
                    $dept.val($dept.val().substring(0, 100));
                }
            });
        });
    </script>
}


