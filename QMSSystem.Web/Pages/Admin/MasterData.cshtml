@page
@model QMSSystem.Web.Pages.Admin.MasterDataModel
@{
    ViewData["Title"] = "Master Data & Inventory";
    ViewData["ActivePage"] = "MasterData";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Master Data & System Overview</h2>
        <p class="text-muted mb-0">System roles, operational departments, and live module counts from the database.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Inventory Cards (Live from Database) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-primary">
            <div class="card-body p-3">
                <div class="text-muted small">Security Roles</div>
                <div class="h4 mb-0 mt-1">@Model.TotalRoles</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-info">
            <div class="card-body p-3">
                <div class="text-muted small">Departments</div>
                <div class="h4 mb-0 mt-1">@Model.TotalDepartments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-success">
            <div class="card-body p-3">
                <div class="text-muted small">Documents</div>
                <div class="h4 mb-0 mt-1">@Model.TotalControlledDocuments</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-warning">
            <div class="card-body p-3">
                <div class="text-muted small">Change Requests</div>
                <div class="h4 mb-0 mt-1">@Model.TotalChangeRequests</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-danger">
            <div class="card-body p-3">
                <div class="text-muted small">Deviations</div>
                <div class="h4 mb-0 mt-1">@Model.TotalDeviations</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card h-100 border-start border-3 border-secondary">
            <div class="card-body p-3">
                <div class="text-muted small">Dev. Reports</div>
                <div class="h4 mb-0 mt-1">@Model.TotalInvestigationReports</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- System Roles from dbo.KS_Roles -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">System Security Roles (@Model.Roles.Count)</span>
                <a asp-page="/Admin/Users" class="small text-decoration-none">Manage Users</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Role ID</th>
                                <th>Role Name</th>
                                <th>Assigned Users</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles)
                            {
                                <tr>
                                    <td>#ROL-@role.RoleId</td>
                                    <td>
                                        <span class="badge @(role.Name switch {
                                            "Admin" => "bg-danger",
                                            "Supervisor" => "bg-warning text-dark",
                                            "Operator" => "bg-primary",
                                            _ => "bg-secondary"
                                        })">@role.Name</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@(Model.RoleUserCounts.TryGetValue(role.Name, out var count) ? count : 0)</span> active
                                    </td>
                                    <td>
                                        <a asp-page="/Admin/Users" asp-route-RoleFilter="@role.Name" class="btn btn-sm btn-outline-secondary py-0">View Users</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Departments from Database -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Registered Departments & Activity (@Model.Departments.Count)</span>
                <a asp-page="/Admin/DocumentRegister/Index" class="small text-decoration-none">View Documents</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Departments.Count == 0)
                {
                    <div class="p-3 text-center text-muted">No department records found in the database.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Department Name</th>
                                    <th class="text-center" style="width: 130px;">Controlled Docs</th>
                                    <th class="text-center" style="width: 120px;">Staff Count</th>
                                    <th class="text-end" style="width: 120px;">Quick Links</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.Departments)
                                {
                                    var docCount = Model.DepartmentDocCounts.TryGetValue(dept, out var dc) ? dc : 0;
                                    var userCount = Model.DepartmentUserCounts.TryGetValue(dept, out var uc) ? uc : 0;
                                    <tr>
                                        <td>
                                            <i class="bi bi-building me-1 text-primary"></i>
                                            <span class="fw-medium">@dept</span>
                                        </td>
                                        <td class="text-center">
                                            @if (docCount > 0)
                                            {
                                                <span class="badge bg-success">@docCount docs</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (userCount > 0)
                                            {
                                                <span class="badge bg-primary">@userCount users</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/DocumentRegister/Index" asp-route-DepartmentFilter="@dept" class="btn btn-sm btn-outline-secondary py-0">Filter Docs</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
