@page
@model QMSSystem.Web.Pages.Admin.ChangeRequests.IndexModel
@{
    ViewData["Title"] = "Change Requests";
    ViewData["ActivePage"] = "ChangeRequests";
}

<partial name="_AdminNav" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 mb-1">Change Requests</h2>
        <p class="text-muted mb-0">Review process, equipment, and document change proposals.</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Search</label>
                <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search title, description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Change Type</label>
                <select name="ChangeTypeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Process" selected="@(Model.ChangeTypeFilter == "Process")">Process</option>
                    <option value="Equipment" selected="@(Model.ChangeTypeFilter == "Equipment")">Equipment</option>
                    <option value="Software" selected="@(Model.ChangeTypeFilter == "Software")">Software</option>
                    <option value="Documentation" selected="@(Model.ChangeTypeFilter == "Documentation")">Documentation</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-page="/Admin/ChangeRequests/Index" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Change Requests Table -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <span class="fw-semibold">Change Request Records (@Model.ChangeRequests.Count)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.ChangeRequests.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No change request records available.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Target Document</th>
                            <th>Title</th>
                            <th>Change Type</th>
                            <th>Status</th>
                            <th>Decision</th>
                            <th>Requested By</th>
                            <th>Requested Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cr in Model.ChangeRequests)
                        {
                            <tr>
                                <td><strong>#CR-@cr.Id</strong></td>
                                <td>#DOC-@cr.DocumentId</td>
                                <td>
                                    <div class="fw-semibold">@cr.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@cr.Description</div>
                                </td>
                                <td>@cr.ChangeType</td>
                                <td>@cr.Status</td>
                                <td>@(string.IsNullOrWhiteSpace(cr.Decision) ? "Pending" : cr.Decision)</td>
                                <td>User #@cr.RequestedByUserId</td>
                                <td>@cr.RequestedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-page="/Admin/ChangeRequests/Details" asp-route-id="@cr.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

