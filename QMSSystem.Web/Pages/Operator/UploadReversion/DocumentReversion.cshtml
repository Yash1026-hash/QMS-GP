@page "/Operator/UploadReversion"
@model DocumentReversionModel

@{
    ViewData["Title"] = "Upload Document Revision";
}

<div class="container py-3">
    <div class="mb-4">
        <p class="text-primary fw-semibold text-uppercase small mb-1">Document control</p>
        <h1 class="h2 mb-1">Upload document revision</h1>
        <p class="text-muted mb-0">Select a document and provide the new revision details.</p>
    </div>

    <section class="card" aria-labelledby="revision-form-heading">
        <div class="card-header bg-body">
            <h2 id="revision-form-heading" class="h5 mb-1">Revision details</h2>
            <p class="text-muted small mb-0">Fields marked with an asterisk are required.</p>
        </div>
        <div class="card-body">
            <form id="revision-form" novalidate>
                <div id="revision-validation-message" class="alert alert-info d-none" role="status">
                    Validation passed. Saving revisions is not connected yet.
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="document-id" class="form-label">Document ID <span class="text-danger">*</span></label>
                        <select id="document-id" name="DocumentId" class="form-select">
                            <option value="">Select a document</option>
                            <option value="1" data-file-name="Quality-Manual.pdf" data-version="2">Document 1 - Quality Manual</option>
                            <option value="2" data-file-name="Standard-Operating-Procedure.pdf" data-version="4">Document 2 - Standard Operating Procedure</option>
                            <option value="3" data-file-name="Work-Instruction.pdf" data-version="2">Document 3 - Work Instruction</option>
                        </select>
                        <div class="form-text">Temporary sample documents for the page design.</div>
                    </div>

                    <div class="col-md-6">
                        <label for="document-file-name" class="form-label">Current document file</label>
                        <input id="document-file-name" class="form-control" disabled
                               placeholder="Select a document to view its file name" />
                    </div>

                    <div class="col-md-6">
                        <label for="version" class="form-label">Version</label>
                        <input id="version" name="Version" type="number" class="form-control"
                               min="1" step="1" placeholder="Select a document first" disabled />
                        <div class="form-text">The next version is set automatically from the selected document.</div>
                    </div>

                    <div class="col-md-6">
                        <label for="uploaded-by" class="form-label">Created by</label>
                        <input id="uploaded-by" name="UploadedBy" class="form-control"
                               value="@User.Identity?.Name" disabled />
                        <div class="form-text">Set from the signed-in account.</div>
                    </div>

                    <div class="col-12">
                        <label for="revision-file" class="form-label">File <span class="text-danger">*</span></label>
                        <input id="revision-file" name="File" type="file" class="form-control"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />
                        <div class="form-text">The selected file name will be saved as FileName.</div>
                        <div class="form-text">Accepted formats: PDF, Word, Excel, and PowerPoint.</div>
                    </div>

                    <div class="col-12">
                        <label for="change-summary" class="form-label">Change summary <span class="text-danger">*</span></label>
                        <textarea id="change-summary" name="ChangeSummary" class="form-control" rows="4"
                                  maxlength="500"
                                  placeholder="Describe the changes made in this revision"></textarea>
                    </div>

                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary">Upload revision</button>
                </div>
            </form>
        </div>
    </section>

    <section class="card mt-4" aria-labelledby="revision-list-heading">
        <div class="card-header bg-body">
            <h2 id="revision-list-heading" class="h5 mb-1">Document revisions</h2>
            <p class="text-muted small mb-0">Revision records will appear here after they are saved.</p>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        
                        <th scope="col">Document ID</th>
                        <th scope="col">Version</th>
                        <th scope="col">File name</th>
                        <th scope="col">Uploaded by</th>
                        <th scope="col">Approved by</th>
                        <th scope="col">Approval date</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="11" class="text-center text-muted py-4">
                            No revision records to display.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const validationMessage = $("#revision-validation-message");

            $.validator.addMethod("revisionFileType", function (value, element) {
                if (element.files.length === 0) {
                    return true;
                }

                return /\.(pdf|doc)$/i.test(element.files[0].name);
            }, "Choose a PDF or Word file.");

            $("#document-id").on("change", function () {
                const selectedOption = this.options[this.selectedIndex];
                $("#document-file-name").val(selectedOption.dataset.fileName || "");
                $("#version").val(selectedOption.dataset.version || "");
            });

            $("#revision-form").validate({
                errorElement: "div",
                errorClass: "invalid-feedback d-block",
                rules: {
                    DocumentId: {
                        required: true
                    },
                    File: {
                        required: true,
                        revisionFileType: true
                    },
                    ChangeSummary: {
                        required: true,
                        maxlength: 500,
                        normalizer: function (value) {
                            return $.trim(value);
                        }
                    }
                },
                messages: {
                    DocumentId: "Select a document Id.",
                    File: {
                        required: "Select a file to upload."
                    },
                    ChangeSummary: {
                        required: "Enter a change summary.",
                        maxlength: "Change summary must not exceed 500 characters."
                    }
                },
                highlight: function (element) {
                    $(element).addClass("is-invalid").removeClass("is-valid");
                },
                unhighlight: function (element) {
                    $(element).removeClass("is-invalid").addClass("is-valid");
                },
                submitHandler: function () {
                    validationMessage.removeClass("d-none");
                    return false;
                },
                invalidHandler: function () {
                    validationMessage.addClass("d-none");
                }
            });
        });
    </script>
}
