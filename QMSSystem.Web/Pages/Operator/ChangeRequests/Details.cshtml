@page "{id:int}"
@model QMSSystem.Web.Pages.Operator.ChangeRequests.DetailsModel

@{
    ViewData["Title"] = "Change Request Details";
}

<main class="change-request-index-page">
    <header class="operator-page-heading mb-4">
        <p class="eyebrow">Operator workspace</p>
        <h1>Change Request Details</h1>
    </header>

    <section class="card p-4">
        @await Component.InvokeAsync(
            "ChangeRequestDetails",
            new { dto = Model.Dto }
        )
    </section>
</main>