@page
@model QMSSystem.Web.Pages.Deviations.CreateModel
@using QMSSystem.Shared.Enums

@{
    ViewData["Title"] = "Create Deviation";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3">Create Deviation</h1>

        <p class="text-muted mb-0">
            Record a deviation from the selected SOP.
        </p>
    </div>

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <form method="post"
          enctype="multipart/form-data">

        <!-- Keep selected SOP ID when form is submitted -->
        <input asp-for="DocumentId" type="hidden" />

        <!-- Selected SOP -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <strong>Selected SOP</strong>
            </div>

            <div class="card-body">

                @if (Model.SelectedSop is not null)
                {
                    <div class="row">

                        <div class="col-md-4">
                            <label class="form-label">
                                SOP Number
                            </label>

                            <input class="form-control"
                                   value="@Model.SelectedSop.DocumentNumber"
                                   readonly />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">
                                SOP Title
                            </label>

                            <input class="form-control"
                                   value="@Model.SelectedSop.Title"
                                   readonly />
                        </div>

                    </div>
                }

            </div>
        </div>


        <!-- Deviation Details -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <strong>Deviation Details</strong>
            </div>

            <div class="card-body">

                <!-- Title -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                        Deviation Title
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter a short title for the deviation" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                        <span class="text-danger">*</span>
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"
                              placeholder="Describe what happened and why it is a deviation from the SOP."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Priority / Severity -->
                <div class="mb-3">

                    <label asp-for="Priority"
                           class="form-label">
                        Priority / Severity
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="Priority"
                            class="form-select">

                        <option value="">
                            Select priority
                        </option>

                        <option value="@Priority.Minor">
                            Minor
                        </option>

                        <option value="@Priority.Major">
                            Major
                        </option>

                        <option value="@Priority.Critical">
                            Critical
                        </option>

                    </select>

                    <span asp-validation-for="Priority"
                          class="text-danger">
                    </span>

                </div>

            </div>
        </div>


        <!-- Proofs -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <strong>Proofs / Supporting Files</strong>
            </div>

            <div class="card-body">

                <label asp-for="Proofs"
                       class="form-label">
                    Upload Proofs
                </label>

                <input asp-for="Proofs"
                       type="file"
                       class="form-control"
                       multiple />

                <div class="form-text">
                    Upload supporting files related to the deviation.
                </div>

                <span asp-validation-for="Proofs"
                      class="text-danger">
                </span>

            </div>
        </div>


        <!-- Actions -->
        <div class="d-flex justify-content-between">

            <a asp-page="/Deviations/SelectSop"
               class="btn btn-outline-secondary">
                Back
            </a>

            <button type="submit"
                    class="btn btn-primary px-4">
                Submit Deviation
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}