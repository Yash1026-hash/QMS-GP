@page
@model QMSSystem.Web.Pages.Deviations.SelectSopModel

@{
    ViewData["Title"] = "Select SOP";
}

<div class="container py-4">

    <div class="mb-4">
        

        <p class="text-muted">
            Select an active SOP to raise the deviation.
        </p>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <!-- Search -->
    <form method="get" class="row g-2 mb-4">

        <div class="col-md-8">
            <label asp-for="Search" class="form-label">
                Search SOP
            </label>

            <input asp-for="Search"
                   class="form-control"
                   placeholder="Search by SOP number or title" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit"
                    class="btn btn-primary w-100">
                Search
            </button>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <a asp-page="/Deviations/SelectSop"
               class="btn btn-outline-secondary w-100">
                Clear
            </a>
        </div>

    </form>

    <!-- SOP Selection -->
    <form method="post"
          asp-page-handler="Continue">

        <div class="card shadow-sm">

            <div class="card-header bg-white">
                <strong>Active SOPs</strong>
            </div>

            <div class="card-body">

                @if (Model.ActiveSops.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        No active SOPs are available.
                    </div>
                }
                else
                {
                    <div class="list-group">

                        @foreach (var sop in Model.ActiveSops)
                        {
                            <label class="list-group-item list-group-item-action">

                                <div class="d-flex align-items-center">

                                    <input type="radio"
                                           asp-for="SelectedSopId"
                                           value="@sop.Id"
                                           class="form-check-input me-3" />

                                    <div>
                                        <div class="fw-semibold">
                                            @sop.DocumentNumber
                                        </div>

                                        <div class="text-muted">
                                            @sop.Title
                                        </div>
                                    </div>

                                </div>

                            </label>
                        }

                    </div>
                }

                <div class="d-flex justify-content-end mt-4">

                    <button type="submit"
                            class="btn btn-primary px-4"
                            @(Model.ActiveSops.Count == 0 ? "disabled" : "")>
                        Continue
                    </button>

                </div>

            </div>
        </div>

    </form>

</div>