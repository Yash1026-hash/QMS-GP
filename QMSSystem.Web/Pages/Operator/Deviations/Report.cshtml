@page "/Deviations/Report"
@model QMSSystem.Web.Pages.Operator.Deviations.ReportModel
@{
    ViewData["Title"] = "Deviation Report";
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / OPERATOR</p>
            <h1 class="h3 mb-1">Deviation Report Submission</h1>
            <p class="text-muted mb-0">Record completed corrective actions and submit supporting documentation for review.</p>
        </div>
        <a href="/Deviations/Index" class="btn btn-outline-secondary">
            &larr; Back to Deviations
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="alert alert-info d-flex align-items-center mb-4" role="status">
        <div>
            <strong>Process:</strong> Select an approved deviation, describe the completed corrective work, and attach the supporting report or evidence file.
        </div>
    </div>

    <form method="post" id="deviationReportForm" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger mb-4" role="alert"></div>

        <!-- SECTION 1: DEVIATION & SOP -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <span class="fw-semibold">1. Deviation &amp; SOP Selection</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SelectedDeviationId" class="form-label fw-semibold">
                            Select Approved Deviation <span class="text-danger">*</span>
                        </label>
                        <input id="deviation-search" type="search" class="form-control mb-2"
                               placeholder="Type to filter deviations..."
                               aria-label="Filter approved deviations" />
                        <select asp-for="SelectedDeviationId" class="form-select" required>
                            <option value="">-- Choose an Approved Deviation --</option>
                            @foreach (var deviation in Model.ApprovedDeviations)
                            {
                                <option value="@deviation.Id"
                                        data-document-id="@deviation.DocumentId"
                                        data-search="@($"{deviation.Id} {deviation.Title} {deviation.Description} {deviation.DocumentId}")">
                                    #DEV-@deviation.Id - @deviation.Title (SOP #@deviation.DocumentId)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="SelectedDeviationId" class="text-danger small d-block"></span>
                        @if (Model.ApprovedDeviations.Count == 0)
                        {
                            <div class="form-text text-warning">There are currently no approved deviations awaiting reports.</div>
                        }
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label asp-for="DeviationId" class="form-label fw-semibold">Deviation ID</label>
                        <input asp-for="DeviationId" type="number" class="form-control" readonly />
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label asp-for="DocumentId" class="form-label fw-semibold">SOP Document ID</label>
                        <input asp-for="DocumentId" type="number" class="form-control" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: REPORT & PROOF -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <span class="fw-semibold">2. Corrective Action Summary &amp; Proof</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Summary" class="form-label fw-semibold">
                            Corrective Action Summary <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Summary"
                                  class="form-control"
                                  rows="5"
                                  maxlength="4000"
                                  placeholder="Describe the corrective actions completed, the observed results, and how the deviation was resolved..."
                                  required></textarea>
                        <span asp-validation-for="Summary" class="text-danger small d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Proof" class="form-label fw-semibold">
                            Proof / Supporting Report Attachment <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Proof" type="file" class="form-control" required />
                        <span asp-validation-for="Proof" class="text-danger small d-block"></span>
                        <div class="form-text">Attach calibration logs, lab reports, test evidence, or photos.</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a href="/Deviations/Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" id="submitReportBtn" class="btn btn-primary">
                        Submit Deviation Report
                    </button>
                </div>
            </div>
        </div>
    </form>

</div>

<script>
    (() => {
        const search = document.getElementById("deviation-search");
        const select = document.getElementById("SelectedDeviationId");
        const deviationId = document.getElementById("DeviationId");
        const documentId = document.getElementById("DocumentId");

        if (!search || !select || !deviationId || !documentId) {
            return;
        }

        const options = Array.from(select.options).slice(1);
        const updateIds = () => {
            const selectedOption = select.selectedOptions[0];
            deviationId.value = selectedOption?.value ?? "";
            documentId.value = selectedOption?.dataset.documentId ?? "";
        };

        select.addEventListener("change", updateIds);
        updateIds();

        search.addEventListener("input", () => {
            const query = search.value.trim().toLocaleLowerCase();
            let selectedOptionHidden = false;

            for (const option of options) {
                const matches = option.dataset.search.toLocaleLowerCase().includes(query);
                option.hidden = !matches;
                if (option.selected && !matches) {
                    selectedOptionHidden = true;
                }
            }

            if (selectedOptionHidden) {
                select.value = "";
                updateIds();
            }
        });
    })();
</script>

@section Scripts {
    <script>
        $(document).ready(function () {
            var $reportForm = $("#deviationReportForm");
            if ($reportForm.length) {
                $reportForm.validate({
                    rules: {
                        SelectedDeviationId: {
                            required: true
                        },
                        Summary: {
                            required: true,
                            minlength: 10,
                            maxlength: 4000
                        },
                        Proof: {
                            required: true
                        }
                    },
                    messages: {
                        SelectedDeviationId: {
                            required: "Please select an approved deviation."
                        },
                        Summary: {
                            required: "Please describe the corrective work completed and outcome.",
                            minlength: "Summary must be at least 10 characters.",
                            maxlength: "Summary cannot exceed 4000 characters."
                        },
                        Proof: {
                            required: "Please upload a proof or supporting report file."
                        }
                    },
                    submitHandler: function (form) {
                        $("#submitReportBtn").prop("disabled", true).text("Submitting report...");
                        form.submit();
                    }
                });
            }
        });
    </script>
}
