@page "/Deviations/SelectSop"
@model QMSSystem.Web.Pages.Operator.Deviations.SelectSopModel
@{
    ViewData["Title"] = "Select an Active SOP";
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / DEVIATIONS</p>
            <h1 class="h3 mb-1">Select an Active SOP</h1>
            <p class="text-muted mb-0">Choose the controlled SOP that the deviation relates to.</p>
        </div>
        <a href="/Deviations/Index" class="btn btn-outline-secondary">
            &larr; Back to Deviations
        </a>
    </div>

    <!-- SEARCH ACTIVE SOPS -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="/Deviations/SelectSop" id="sopSearchForm" class="row g-2 align-items-end">
                <div class="col-md-6 col-sm-8">
                    <label for="Search" class="form-label">Search active SOPs</label>
                    <input id="Search"
                           name="Search"
                           class="form-control"
                           maxlength="100"
                           value="@Model.Search"
                           placeholder="Search by document number, title, or department" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a href="/Deviations/SelectSop" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ACTIVE SOPS SELECTION -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Active SOP Documents</span>
            <span class="badge bg-secondary">Total: @Model.ActiveSops.Count</span>
        </div>

        @if (Model.ActiveSops.Count == 0)
        {
            <div class="card-body text-center p-4">
                <h5 class="text-muted">@(string.IsNullOrWhiteSpace(Model.Search) ? "No active SOPs are available" : "No matching active SOPs")</h5>
                <p class="text-muted mb-3">
                    Active SOPs will appear here when an active document is registered.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/Deviations/Index" class="btn btn-outline-secondary">Back to Deviations</a>
                    <a href="/Deviations/Create" class="btn btn-primary">Open Blank Deviation Form</a>
                </div>
            </div>
        }
        else
        {
            <form method="get" action="/Deviations/Create" id="selectSopForm" novalidate>
                <div class="table-responsive sop-table-wrap">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;" class="text-center">Select</th>
                                <th>Document Title &amp; Number</th>
                                <th>Department</th>
                                <th style="width: 100px;">Version</th>
                                <th style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sop in Model.ActiveSops)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="radio"
                                               class="form-check-input"
                                               id="sop-@sop.Id"
                                               name="DocumentId"
                                               value="@sop.Id"
                                               required />
                                    </td>
                                    <td>
                                        <label for="sop-@sop.Id" class="fw-semibold mb-0 d-block" style="cursor: pointer;">
                                            @sop.Title
                                        </label>
                                        <div class="small text-muted">@sop.DocumentNumber</div>
                                    </td>
                                    <td>@sop.Department</td>
                                    <td>v@sop.DocumentVersion</td>
                                    <td><span class="badge bg-success">@sop.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-light d-flex justify-content-end gap-2 py-3">
                    <a href="/Deviations/Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        Continue to Deviation Form &rarr;
                    </button>
                </div>
            </form>
        }
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#sopSearchForm").on("submit", function () {
                var $s = $("#Search");
                if ($s.val().length > 100) {
                    $s.val($s.val().substring(0, 100));
                }
            });

            var $selectForm = $("#selectSopForm");
            if ($selectForm.length) {
                $selectForm.validate({
                    rules: {
                        DocumentId: {
                            required: true
                        }
                    },
                    messages: {
                        DocumentId: {
                            required: "Please select an active SOP before proceeding."
                        }
                    },
                    errorPlacement: function (error, element) {
                        error.insertAfter(".sop-table-wrap");
                    }
                });
            }
        });
    </script>
}