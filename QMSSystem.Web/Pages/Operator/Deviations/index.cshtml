@page "/Deviations/Index"
@model QMSSystem.Web.Pages.Operator.Deviations.IndexModel

@{
    ViewData["Title"] = "Deviations";
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / OPERATOR</p>
            <h1 class="h3 mb-1">Deviations</h1>
            <p class="text-muted mb-0">View and track deviations raised against controlled SOPs.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="/Deviations/SelectSop" class="btn btn-primary">
                + Create New Deviation
            </a>
            <a href="/Deviations/Report" class="btn btn-outline-secondary">
                Deviation Reports
            </a>
        </div>
    </div>

    <!-- SEARCH AND FILTER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" id="operatorDeviationsFilterForm" class="row g-2 align-items-end">
                <div class="col-md-5 col-sm-6">
                    <label for="Search" class="form-label">Search</label>
                    <input type="text"
                           id="Search"
                           name="Search"
                           class="form-control"
                           maxlength="100"
                           value="@Model.Search"
                           placeholder="Search deviations by title, description..." />
                </div>

                <div class="col-md-3 col-sm-6">
                    <label for="Priority" class="form-label">Priority</label>
                    <select id="Priority" name="Priority" class="form-select">
                        <option value="">All Priorities</option>
                        <option value="Minor" selected="@(Model.Priority == "Minor")">Minor</option>
                        <option value="Major" selected="@(Model.Priority == "Major")">Major</option>
                        <option value="Critical" selected="@(Model.Priority == "Critical")">Critical</option>
                    </select>
                </div>

                <div class="col-md-2 col-sm-6">
                    <label for="Status" class="form-label">Status</label>
                    <select id="Status" name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="0" selected="@(Model.Status == 0)">Pending</option>
                        <option value="1" selected="@(Model.Status == 1)">Active</option>
                        <option value="2" selected="@(Model.Status == 2)">Inactive</option>
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Priority) || Model.Status.HasValue)
                    {
                        <a href="/Deviations/Index" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- DEVIATION LIST -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Deviation List</span>
            <span class="badge bg-secondary">Total: @Model.TotalCount</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Deviations != null && Model.Deviations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>Title &amp; Description</th>
                                <th style="width: 140px;">SOP / Document</th>
                                <th style="width: 110px;">Priority</th>
                                <th style="width: 120px;">Status</th>
                                <th style="width: 130px;">Raised By</th>
                                <th style="width: 110px;">Created</th>
                                <th style="width: 90px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deviation in Model.Deviations)
                            {
                                <tr>
                                    <td>#DEV-@deviation.Id</td>
                                    <td>
                                        <div class="fw-semibold">@deviation.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(deviation.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 450px;">
                                                @deviation.Description
                                            </div>
                                        }
                                    </td>
                                    <td>#DOC-@deviation.DocumentId</td>
                                    <td>
                                        <span class="badge @(deviation.Priority switch {
                                            "Critical" => "bg-danger",
                                            "Major" => "bg-warning text-dark",
                                            "Minor" => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        })">@Model.GetPriorityText(deviation.Priority)</span>
                                    </td>
                                    <td>
                                        <span class="badge @(deviation.Status switch {
                                            1 => "bg-success",
                                            0 => "bg-warning text-dark",
                                            2 => "bg-danger",
                                            _ => "bg-secondary"
                                        })">
                                            @(deviation.Status switch {
                                                1 => "Active",
                                                0 => "Pending",
                                                2 => "Inactive",
                                                _ => "Unknown"
                                            })
                                        </span>
                                    </td>
                                    <td>@deviation.CreatedBy</td>
                                    <td>@deviation.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center">
                                        <a href="/Deviations/Details?id=@deviation.Id" class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted p-4">
                    No deviations found matching the search or filter criteria.
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light d-flex justify-content-center py-2">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/Deviations/Index?PageNumber=@(Model.PageNumber - 1)&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">Previous</a>
                    </li>

                    @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="/Deviations/Index?PageNumber=@pageNumber&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Deviations/Index?PageNumber=@(Model.PageNumber + 1)&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#operatorDeviationsFilterForm").on("submit", function () {
                var $s = $("#Search");
                if ($s.val().length > 100) {
                    $s.val($s.val().substring(0, 100));
                }
            });
        });
    </script>
}