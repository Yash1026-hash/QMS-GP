@page "/Deviations/Index"
@model QMSSystem.Web.Pages.Operator.Deviations.IndexModel

@{
    ViewData["Title"] = "Deviations";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background-color: #f8fafc;
        color: #1e293b;
        font-family: Arial, Helvetica, sans-serif;
    }

    .deviation-page {
        min-height: 100vh;
        background: #f8fafc;
    }

    /* =========================
       TOP HEADER
       ========================= */

    .top-header {
        height: 72px;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 48px;
    }

    .qms-logo {
        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: 0.5px;
    }

    .sign-in {
        color: #2563eb;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
    }

    .sign-in:hover {
        text-decoration: underline;
    }

    /* =========================
       MAIN CONTAINER
       ========================= */

    .main-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 42px 48px 60px;
    }

    /* =========================
       PAGE HEADER
       ========================= */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
    }

    .page-title-section h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
        color: #0f172a;
    }

    .page-title-section p {
        margin: 0;
        font-size: 15px;
        color: #64748b;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .btn {
        height: 42px;
        padding: 0 18px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-create {
        background: #2563eb;
        color: #ffffff;
        border: 1px solid #2563eb;
    }

    .btn-create:hover {
        background: #1d4ed8;
        color: #ffffff;
    }

    .btn-report {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .btn-report:hover {
        background: #f8fafc;
    }

    /* =========================
       FILTER CARD
       ========================= */

    .filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 28px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .filter-row {
        display: grid;
        grid-template-columns: 1.9fr 1fr 1fr auto auto;
        gap: 16px;
        align-items: end;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
    }

    .filter-field label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }

    .filter-field input,
    .filter-field select {
        width: 100%;
        height: 42px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        padding: 0 12px;
        font-size: 14px;
        color: #334155;
        background: #ffffff;
        outline: none;
    }

    .filter-field input:focus,
    .filter-field select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.10);
    }

    .btn-search {
        height: 42px;
        min-width: 80px;
        border: 1px solid #2563eb;
        border-radius: 7px;
        background: #2563eb;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-search:hover {
        background: #1d4ed8;
    }

    .btn-clear {
        height: 42px;
        min-width: 75px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: #ffffff;
        color: #475569;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-clear:hover {
        background: #f8fafc;
    }

    /* =========================
       DEVIATION LIST CARD
       ========================= */

    .list-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    .list-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 24px;
        border-bottom: 1px solid #e2e8f0;
    }

    .list-card-header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
    }

    .record-count {
        font-size: 13px;
        color: #64748b;
    }

    /* =========================
       TABLE
       ========================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .deviation-table {
        width: 100%;
        border-collapse: collapse;
    }

    .deviation-table th {
        text-align: left;
        padding: 14px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .deviation-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 14px;
        color: #334155;
    }

    .deviation-table tbody tr:hover {
        background: #f8fafc;
    }

    .title-cell {
        font-weight: 600;
        color: #0f172a;
    }

    .description-cell {
        margin-top: 4px;
        font-size: 12px;
        color: #94a3b8;
    }

    /* =========================
       STATUS BADGES
       ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background: #e2e8f0;
        color: #475569;
    }

    .action-btn {
        padding: 7px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        color: #2563eb;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .action-btn:hover {
        background: #eff6ff;
        border-color: #93c5fd;
    }

    /* =========================
       EMPTY STATE
       ========================= */

    .empty-state {
        text-align: center;
        padding: 72px 20px;
    }

    .empty-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
        border-radius: 12px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        font-size: 25px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
    }

    .empty-state p {
        margin: 0;
        font-size: 14px;
        color: #64748b;
    }

    /* =========================
       PAGINATION
       ========================= */

    .pagination-container {
        padding: 18px 24px;
        border-top: 1px solid #e2e8f0;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .page-link {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    .page-link:hover {
        background: #f8fafc;
    }

    .page-item.active .page-link {
        background: #2563eb;
        border-color: #2563eb;
        color: #ffffff;
    }

    .page-item.disabled .page-link {
        opacity: 0.5;
        pointer-events: none;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 1000px) {

        .top-header {
            padding: 0 24px;
        }

        .main-container {
            padding: 32px 24px 50px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .filter-row {
            grid-template-columns: 1fr 1fr;
        }

        .search-field {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 650px) {

        .top-header {
            padding: 0 16px;
        }

        .main-container {
            padding: 24px 16px 40px;
        }

        .page-title-section h1 {
            font-size: 27px;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

        .header-actions .btn {
            width: 100%;
        }

        .filter-row {
            grid-template-columns: 1fr;
        }

        .search-field {
            grid-column: auto;
        }
    }
</style>

<div class="deviation-page">

    <!-- =========================
         TOP HEADER
         ========================= -->

    <header class="top-header">

        <div class="qms-logo">
            QMS
        </div>

        <a href="/Account/Login"
           class="sign-in">
            Sign in
        </a>

    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main class="main-container">

        <!-- Page Header -->

        <div class="page-header">

            <div class="page-title-section">

                <h1>Deviations</h1>

                <p>
                    View and track deviations raised against controlled SOPs.
                </p>

            </div>


            <div class="header-actions">

                <a href="/Operator/Deviations/SelectSop"
                   class="btn btn-create">
                    + Create New Deviation
                </a>

                <a href="/Operator/Deviations/Report"
                   class="btn btn-report">
                    Deviation Reports
                </a>

            </div>

        </div>


        <!-- =========================
             SEARCH AND FILTER
             ========================= -->

        <div class="filter-card">

            <form method="get">

                <div class="filter-row">

                    <div class="filter-field search-field">

                        <label for="Search">
                            Search
                        </label>

                        <input type="text"
                               id="Search"
                               name="Search"
                               value="@Model.Search"
                               placeholder="Search deviations..." />

                    </div>


                    <div class="filter-field">

                        <label for="Priority">
                            Priority
                        </label>

                        <select id="Priority"
                                name="Priority">

                            <option value="">
                                All Priorities
                            </option>

                            <option value="Minor">
                                Minor
                            </option>

                            <option value="Major">
                                Major
                            </option>

                            <option value="Critical">
                                Critical
                            </option>

                        </select>

                    </div>


                    <button type="submit"
                            class="btn-search">
                        Search
                    </button>


                    <a href="/Deviations/Index"
                       class="btn-clear">
                        Clear
                    </a>

                </div>

            </form>

        </div>


        <!-- =========================
             DEVIATION LIST
             ========================= -->

        <div class="list-card">

            <div class="list-card-header">

                <h2>
                    Deviation List
                </h2>

                <span class="record-count">
                    @Model.TotalCount deviation(s)
                </span>

            </div>


            @if (Model.Deviations != null && Model.Deviations.Any())
            {
                <div class="table-wrapper">

                    <table class="deviation-table">

                        <thead>

                            <tr>

                                <th>ID</th>

                                <th>Title</th>

                                <th>SOP / Document</th>

                                <th>Priority</th>

                                <th>Raised By</th>

                                <th>Created</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var deviation in Model.Deviations)
                            {
                                <tr>

                                    <td>
                                        @deviation.Id
                                    </td>

                                    <td>

                                        <div class="title-cell">
                                            @deviation.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(deviation.Description))
                                        {
                                            <div class="description-cell">
                                                @deviation.Description
                                            </div>
                                        }

                                    </td>

                                    <td>
                                        @deviation.DocumentId
                                    </td>

                                    <td>
                                        @Model.GetPriorityText(deviation.Priority)
                                    </td>

                                    <td>
                                        @deviation.CreatedBy
                                    </td>

                                    <td>
                                        @deviation.CreatedDate.ToString("dd MMM yyyy")
                                    </td>

                                   
                                    <td>

                                        <a href="/Operator/Deviations/Details?id=@deviation.Id"
                                           class="action-btn">
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        □
                    </div>

                    <h3>
                        No deviations found
                    </h3>

                    <p>
                        There are no deviations matching your search or filter criteria.
                    </p>

                </div>
            }


            <!-- Pagination -->

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-container">

                    <ul class="pagination">

                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               href="/Deviations/Index?PageNumber=@(Model.PageNumber - 1)&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">
                                Previous
                            </a>

                        </li>


                        @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                                <a class="page-link"
                                   href="/Deviations/Index?PageNumber=@pageNumber&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">
                                    @pageNumber
                                </a>

                            </li>
                        }


                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               href="/Deviations/Index?PageNumber=@(Model.PageNumber + 1)&Search=@Model.Search&Priority=@Model.Priority&Status=@Model.Status">
                                Next
                            </a>

                        </li>

                    </ul>

                </div>
            }

        </div>

    </main>

</div>