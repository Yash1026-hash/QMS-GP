@page "/Deviations/Details"
@model QMSSystem.Web.Pages.Operator.Deviations.DetailsModel
@{
    ViewData["Title"] = Model.Deviation != null ? $"Deviation #{Model.Deviation.Id}" : "Deviation Details";
}

<!-- PAGE HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pt-2">
    <div>
        <h2 class="h4 mb-1">Deviation Details</h2>
        <p class="text-muted mb-0">Complete record, priority, and review status for this deviation.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Deviations/Index" class="btn btn-outline-secondary">
            &larr; Back to Deviations
        </a>
        @if (Model.Deviation != null && Model.Deviation.Decision == 1)
        {
            <a href="/Deviations/Report?SelectedDeviationId=@Model.Deviation.Id" class="btn btn-primary">
                Submit Report &rarr;
            </a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Deviation != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Deviation Information (#DEV-@Model.Deviation.Id)</span>
            <span class="badge @(Model.Deviation.Status == 0 ? "bg-warning text-dark" : Model.Deviation.Status == 1 ? "bg-success" : "bg-danger")">
                @(Model.Deviation.Status == 0 ? "Pending Review" : Model.Deviation.Status == 1 ? "Active / Approved" : "Inactive / Rejected")
            </span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <div class="small text-muted">Deviation ID</div>
                    <div class="fw-semibold">#DEV-@Model.Deviation.Id</div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="small text-muted">Related SOP / Document</div>
                    <div class="fw-semibold">
                        <a href="/Documents/Details?id=@Model.Deviation.DocumentId" class="text-decoration-none">
                            #DOC-@Model.Deviation.DocumentId
                        </a>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="small text-muted">Priority Level</div>
                    <div>
                        <span class="badge @(Model.Deviation.Priority switch {
                            "Critical" or "High" => "bg-danger",
                            "Major" or "Medium" => "bg-warning text-dark",
                            "Minor" or "Low" => "bg-info text-dark",
                            _ => "bg-secondary"
                        })">@Model.Deviation.Priority</span>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="small text-muted">Created By</div>
                    <div class="fw-semibold">@Model.Deviation.CreatedBy</div>
                </div>

                <div class="col-sm-6 col-md-6">
                    <div class="small text-muted">Created Date</div>
                    <div class="fw-semibold">@Model.Deviation.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div class="col-sm-6 col-md-6">
                    <div class="small text-muted">Supervisor Review Status</div>
                    <div>
                        @if (Model.Deviation.Decision == 1)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (Model.Deviation.Decision == 2)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Awaiting Supervisor Review</span>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="small text-muted">Title</div>
                    <div class="fw-semibold fs-5">@Model.Deviation.Title</div>
                </div>

                <div class="col-12">
                    <div class="small text-muted">Description &amp; Observed Variance</div>
                    <div class="p-3 bg-light rounded border mt-1">
                        @Model.Deviation.Description
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Deviation.DecisionComments))
                {
                    <div class="col-12">
                        <div class="small text-muted">Supervisor Decision Comments</div>
                        <div class="p-3 bg-light rounded border mt-1 text-muted">
                            <strong>Reviewed by @(Model.Deviation.DecisionBy ?? "Supervisor") on @(Model.Deviation.DecisionOn?.ToString("yyyy-MM-dd HH:mm") ?? "-"):</strong><br />
                            @Model.Deviation.DecisionComments
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <span class="small text-muted">Logged in Quality Management System</span>
            <a href="/Deviations/Index" class="btn btn-sm btn-outline-secondary">
                Back to List
            </a>
        </div>
    </div>
}