@page "/Deviations/Details"
@model QMSSystem.Web.Pages.Operator.Deviations.DetailsModel

@{
    ViewData["Title"] = "Deviation Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/deviation-details.css" asp-append-version="true" />
}

<div class="deviation-details-page">
    <div class="deviation-details-container">
        <div class="deviation-details-heading">
            <div>
                <p class="deviation-eyebrow">Operator workspace</p>
                <h1>Deviation Details</h1>
                <p class="deviation-subtitle">View the submitted deviation and its supervisor review.</p>
            </div>
            <a asp-page="/Operator/Deviations/Index" class="deviation-back-button">
                Back to deviations
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        else if (Model.Deviation is not null)
        {
            <section class="deviation-details-card" aria-labelledby="deviation-information-heading">
                <div class="deviation-card-heading">
                    <div>
                        <h2 id="deviation-information-heading">Deviation information</h2>
                        <p>Primary details submitted by the operator.</p>
                    </div>
                    <span class="deviation-id-badge">ID @Model.Deviation.Id</span>
                </div>

                <div class="deviation-card-body">
                    <div class="deviation-information-grid">
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Deviation ID</span>
                            <div class="deviation-info-value">@Model.Deviation.Id</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Status</span>
                            <div class="deviation-info-value">
                                <span class="deviation-status @Model.StatusCssClass">@Model.StatusText</span>
                            </div>
                        </div>
                        <div class="deviation-info-item deviation-info-full">
                            <span class="deviation-info-label">Deviation title</span>
                            <div class="deviation-info-value">@Model.DisplayValue(Model.Deviation.Title)</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Related SOP</span>
                            <div class="deviation-info-value">@Model.DocumentNumber</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">SOP title</span>
                            <div class="deviation-info-value">@Model.DocumentTitle</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Priority</span>
                            <div class="deviation-info-value">@Model.DisplayValue(Model.Deviation.Priority)</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Raised by</span>
                            <div class="deviation-info-value">@Model.DisplayValue(Model.Deviation.CreatedBy)</div>
                        </div>
                        <div class="deviation-info-item">
                            <span class="deviation-info-label">Issued date</span>
                            <div class="deviation-info-value">@Model.Deviation.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                        </div>
                        <div class="deviation-info-item deviation-info-full">
                            <span class="deviation-info-label">About deviation</span>
                            <div class="deviation-info-value deviation-description">@Model.DisplayValue(Model.Deviation.Description)</div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="deviation-details-card" aria-labelledby="deviation-proof-heading">
                <div class="deviation-card-heading">
                    <div>
                        <h2 id="deviation-proof-heading">Proofs</h2>
                        <p>Attachments submitted with the deviation.</p>
                    </div>
                </div>
                <div class="deviation-card-body">
                    <div class="deviation-proof-note">
                        No proof attachment is recorded for this deviation.
                    </div>
                </div>
            </section>

            <section class="deviation-details-card" aria-labelledby="supervisor-review-heading">
                <div class="deviation-card-heading">
                    <div>
                        <h2 id="supervisor-review-heading">Supervisor review</h2>
                        <p>Decision information recorded by the supervisor.</p>
                    </div>
                </div>
                <div class="deviation-card-body">
                    @if (Model.Deviation.Decision is 1 or 2)
                    {
                        <div class="deviation-review-summary @Model.StatusCssClass">
                            <strong>@Model.StatusText</strong>
                            <dl>
                                <div>
                                    <dt>Reviewed by</dt>
                                    <dd>@Model.DisplayValue(Model.Deviation.DecisionBy)</dd>
                                </div>
                                <div>
                                    <dt>Review date</dt>
                                    <dd>@(Model.Deviation.DecisionOn?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Not available")</dd>
                                </div>
                                <div>
                                    <dt>Comments</dt>
                                    <dd>@Model.DisplayValue(Model.Deviation.DecisionComments)</dd>
                                </div>
                            </dl>
                        </div>
                    }
                    else
                    {
                        <div class="deviation-review-summary pending">
                            <strong>Pending supervisor review</strong>
                            <p>This deviation is awaiting a supervisor decision.</p>
                        </div>
                    }
                </div>
            </section>
        }
        else if (Model.Id <= 0)
        {
            <div class="alert alert-warning" role="alert">A valid deviation ID was not provided.</div>
        }

        <a asp-page="/Operator/Deviations/Index" class="deviation-back-button deviation-bottom-back">
            Back to deviations
        </a>
    </div>
</div>
