@page
@model QMSSystem.Web.Pages.Deviations.IndexModel

@using QMSSystem.Shared.Enums

@{
    ViewData["Title"] = "Deviations";
}

<div class="deviation-page">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="page-header">

        <div class="page-title-section">

            <h1>
                Deviations
            </h1>

            <p>
                View and track deviations raised against controlled SOPs.
            </p>

        </div>

        <div class="header-actions">

            <!-- ============================================== -->
            <!-- CREATE NEW DEVIATION                           -->
            <!-- Redirects to Active SOP selection page         -->
            <!-- ============================================== -->

            <a  asp-page="/Deviations/SelectSop"
               class="btn btn-create">

                + Create New Deviation

            </a>


            <!-- ============================================== -->
            <!-- DEVIATION REPORTS                              -->
            <!-- UI ONLY FOR NOW                                -->
            <!-- ============================================== -->

            <button type="button"
                    class="btn btn-report">

                Deviation Reports

            </button>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SEARCH AND FILTER -->
    <!-- ===================================================== -->

    <div class="filter-card">

        <form method="get">

            <div class="filter-row">

                <!-- ================= SEARCH ================= -->

                <div class="filter-field search-field">

                    <label for="Search">
                        Search
                    </label>

                    <input type="text"
                           id="Search"
                           name="Search"
                           value="@Model.Search"
                           placeholder="Search title, description or operator" />

                </div>


                <!-- ================ PRIORITY ================ -->

                <div class="filter-field">

                    <label for="Priority">
                        Priority
                    </label>

                    <select id="Priority"
                            name="Priority">

                        <option value="">
                            All Priorities
                        </option>


                        @if (Model.Priority == Priority.Minor)
                        {
                            <option value="Minor" selected>
                                Minor
                            </option>
                        }
                        else
                        {
                            <option value="Minor">
                                Minor
                            </option>
                        }


                        @if (Model.Priority == Priority.Major)
                        {
                            <option value="Major" selected>
                                Major
                            </option>
                        }
                        else
                        {
                            <option value="Major">
                                Major
                            </option>
                        }


                        @if (Model.Priority == Priority.Critical)
                        {
                            <option value="Critical" selected>
                                Critical
                            </option>
                        }
                        else
                        {
                            <option value="Critical">
                                Critical
                            </option>
                        }

                    </select>

                </div>


                <!-- ================= STATUS ================= -->

                <div class="filter-field">

                    <label for="Status">
                        Status
                    </label>

                    <select id="Status"
                            name="Status">

                        <option value="">
                            All Statuses
                        </option>


                        @if (Model.Status == DeviationStatus.Open)
                        {
                            <option value="Open" selected>
                                Pending
                            </option>
                        }
                        else
                        {
                            <option value="Open">
                                Pending
                            </option>
                        }


                        @if (Model.Status == DeviationStatus.Investigating)
                        {
                            <option value="Investigating" selected>
                                Investigating
                            </option>
                        }
                        else
                        {
                            <option value="Investigating">
                                Investigating
                            </option>
                        }


                        @if (Model.Status == DeviationStatus.Closed)
                        {
                            <option value="Closed" selected>
                                Closed
                            </option>
                        }
                        else
                        {
                            <option value="Closed">
                                Closed
                            </option>
                        }


                        @if (Model.Status == DeviationStatus.Rejected)
                        {
                            <option value="Rejected" selected>
                                Rejected
                            </option>
                        }
                        else
                        {
                            <option value="Rejected">
                                Rejected
                            </option>
                        }

                    </select>

                </div>


                <!-- ============== SEARCH BUTTONS ============== -->

                <div class="filter-buttons">

                    <button type="submit"
                            class="btn btn-search">

                        Search

                    </button>


                    <a href="/Deviations/Index"
                       class="btn btn-clear">

                        Clear

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- ===================================================== -->
    <!-- ERROR MESSAGE -->
    <!-- ===================================================== -->

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-message">

            @Model.ErrorMessage

        </div>
    }


    <!-- ===================================================== -->
    <!-- LIST HEADER -->
    <!-- ===================================================== -->

    <div class="list-header">

        <h2>
            Deviation List
        </h2>

        <span class="total-count">

            @Model.TotalCount deviation(s)

        </span>

    </div>


    <!-- ===================================================== -->
    <!-- EMPTY STATE -->
    <!-- ===================================================== -->

    @if (Model.Deviations.Count == 0)
    {
        <div class="empty-state">

            <h3>
                No deviations found
            </h3>

            <p>
                There are no deviations matching the selected filters.
            </p>

        </div>
    }
    else
    {

        <!-- ================================================= -->
        <!-- DEVIATION TABLE -->
        <!-- ================================================= -->

        <div class="table-card">

            <div class="table-responsive">

                <table class="deviation-table">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Title
                            </th>

                            <th>
                                SOP
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Raised By
                            </th>

                            <th>
                                Created
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var deviation in Model.Deviations)
                        {
                            <tr>

                                <!-- ================= ID ================= -->

                                <td>

                                    <strong>
                                        D-@deviation.Id.ToString("D4")
                                    </strong>

                                </td>


                                <!-- ================ TITLE ================ -->

                                <td>

                                    @deviation.Title

                                </td>


                                <!-- ================= SOP ================= -->

                                <td>

                                    SOP #@deviation.DocumentId

                                </td>


                                <!-- =============== PRIORITY ============== -->

                                <td>

                                    @if (deviation.Priority == Priority.Critical)
                                    {
                                        <span class="priority critical">
                                            Critical
                                        </span>
                                    }
                                    else if (deviation.Priority == Priority.Major)
                                    {
                                        <span class="priority major">
                                            Major
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="priority minor">
                                            Minor
                                        </span>
                                    }

                                </td>


                                <!-- =============== RAISED BY ============== -->

                                <td>

                                    @deviation.CreatedBy

                                </td>


                                <!-- ================ CREATED =============== -->

                                <td>

                                    @deviation.CreatedDate
                                        .ToLocalTime()
                                        .ToString("dd-MM-yyyy")

                                </td>


                                <!-- ================= STATUS =============== -->

                                <td>

                                    @if (deviation.Status == DeviationStatus.Open)
                                    {
                                        <span class="status pending">
                                            Pending
                                        </span>
                                    }
                                    else if (deviation.Status ==
                                             DeviationStatus.Investigating)
                                    {
                                        <span class="status investigating">
                                            Investigating
                                        </span>
                                    }
                                    else if (deviation.Status ==
                                             DeviationStatus.Closed)
                                    {
                                        <span class="status closed">
                                            Closed
                                        </span>
                                    }
                                    else if (deviation.Status ==
                                             DeviationStatus.Rejected)
                                    {
                                        <span class="status rejected">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status">
                                            @deviation.Status
                                        </span>
                                    }

                                </td>


                                <!-- ================= ACTION ================ -->

                                <td>

                                    <!--
                                        UI ONLY FOR NOW.

                                        Details page will be connected
                                        when the other team member
                                        completes it.
                                    -->

                                    <button type="button"
                                            class="btn-view">

                                        View

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">

            <!-- ================= PREVIOUS ================= -->

            @if (Model.PageNumber > 1)
            {
                <a class="page-button"
                   asp-page="/Deviations/Index"
                   asp-route-Search="@Model.Search"
                   asp-route-Priority="@Model.Priority"
                   asp-route-Status="@Model.Status"
                   asp-route-PageNumber="@(Model.PageNumber - 1)">

                    Previous

                </a>
            }


            <!-- ================= PAGE NUMBERS ============= -->

            @for (
                var pageNumber = 1;
                pageNumber <= Model.TotalPages;
                pageNumber++)
            {
                @if (pageNumber == Model.PageNumber)
                {
                    <span class="page-button active">

                        @pageNumber

                    </span>
                }
                else
                {
                    <a class="page-button"
                       asp-page="/Deviations/Index"
                       asp-route-Search="@Model.Search"
                       asp-route-Priority="@Model.Priority"
                       asp-route-Status="@Model.Status"
                       asp-route-PageNumber="@pageNumber">

                        @pageNumber

                    </a>
                }
            }


            <!-- ================= NEXT ==================== -->

            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="page-button"
                   asp-page="/Deviations/Index"
                   asp-route-Search="@Model.Search"
                   asp-route-Priority="@Model.Priority"
                   asp-route-Status="@Model.Status"
                   asp-route-PageNumber="@(Model.PageNumber + 1)">

                    Next

                </a>
            }

        </div>
    }

</div>


<!-- ========================================================= -->
<!-- CSS -->
<!-- ========================================================= -->

<style>

    /* ================= PAGE ================= */

    .deviation-page {
        padding: 30px;
    }


    /* ================= HEADER ================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }


    .page-title-section h1 {
        margin: 0;
        font-size: 30px;
    }


    .page-title-section p {
        margin-top: 6px;
        color: #6b7280;
    }


    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    /* ================= BUTTONS ================= */

    .btn {
        display: inline-block;
        padding: 9px 15px;
        border-radius: 6px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        box-sizing: border-box;
    }


    .btn-create {
        background: #2563eb;
        color: white;
    }


    .btn-create:hover {
        background: #1d4ed8;
        color: white;
    }


    .btn-report {
        background: white;
        color: #2563eb;
        border: 1px solid #2563eb;
    }


    .btn-report:hover {
        background: #eff6ff;
    }


    .btn-search {
        background: #2563eb;
        color: white;
    }


    .btn-search:hover {
        background: #1d4ed8;
    }


    .btn-clear {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }


    .btn-clear:hover {
        background: #e5e7eb;
    }


    /* ================= FILTER ================= */

    .filter-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }


    .filter-row {
        display: flex;
        gap: 15px;
        align-items: flex-end;
        flex-wrap: wrap;
    }


    .filter-field {
        min-width: 180px;
        flex: 1;
    }


    .search-field {
        flex: 2;
    }


    .filter-field label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
    }


    .filter-field input,
    .filter-field select {
        width: 100%;
        box-sizing: border-box;
        padding: 9px 11px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: white;
        font-size: 14px;
    }


    .filter-field input:focus,
    .filter-field select:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
    }


    .filter-buttons {
        display: flex;
        gap: 8px;
    }


    /* ================= ERROR ================= */

    .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        padding: 12px 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }


    /* ================= LIST HEADER ================= */

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }


    .list-header h2 {
        margin: 0;
        font-size: 20px;
    }


    .total-count {
        color: #6b7280;
        font-size: 14px;
    }


    /* ================= TABLE ================= */

    .table-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }


    .table-responsive {
        overflow-x: auto;
    }


    .deviation-table {
        width: 100%;
        border-collapse: collapse;
    }


    .deviation-table th {
        background: #f8fafc;
        padding: 13px;
        text-align: left;
        font-size: 13px;
        color: #374151;
        white-space: nowrap;
    }


    .deviation-table td {
        padding: 13px;
        border-top: 1px solid #e5e7eb;
        font-size: 14px;
        vertical-align: middle;
    }


    .deviation-table tbody tr:hover {
        background: #f8fafc;
    }


    /* ================= PRIORITY ================= */

    .priority {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }


    .priority.minor {
        background: #ecfdf5;
        color: #047857;
    }


    .priority.major {
        background: #fff7ed;
        color: #c2410c;
    }


    .priority.critical {
        background: #fef2f2;
        color: #b91c1c;
    }


    /* ================= STATUS ================= */

    .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }


    .status.pending {
        background: #fef3c7;
        color: #92400e;
    }


    .status.investigating {
        background: #dbeafe;
        color: #1d4ed8;
    }


    .status.closed {
        background: #dcfce7;
        color: #166534;
    }


    .status.rejected {
        background: #fee2e2;
        color: #991b1b;
    }


    /* ================= VIEW ================= */

    .btn-view {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 6px;
        border: 1px solid #2563eb;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }


    .btn-view:hover {
        background: #dbeafe;
    }


    /* ================= EMPTY ================= */

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        border: 1px dashed #d1d5db;
        border-radius: 10px;
        background: white;
    }


    .empty-state h3 {
        margin-bottom: 8px;
    }


    .empty-state p {
        color: #6b7280;
    }


    /* ================= PAGINATION ================= */

    .pagination-container {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 20px;
        flex-wrap: wrap;
    }


    .page-button {
        display: inline-block;
        padding: 7px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        text-decoration: none;
        color: #374151;
        background: white;
    }


    .page-button:hover {
        background: #f3f4f6;
    }


    .page-button.active {
        background: #2563eb;
        color: white;
        border-color: #2563eb;
    }


    /* ================= MOBILE ================= */

    @@media (max-width: 768px) {

        .deviation-page {
            padding: 15px;
        }


        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }


        .header-actions {
            width: 100%;
        }


        .header-actions .btn {
            flex: 1;
            text-align: center;
        }


        .filter-row {
            flex-direction: column;
            align-items: stretch;
        }


        .filter-field {
            width: 100%;
        }


        .filter-buttons {
            width: 100%;
        }


        .filter-buttons .btn {
            flex: 1;
            text-align: center;
        }


        .deviation-table {
            min-width: 900px;
        }

    }

</style>