@page
@{
    ViewData["Title"] = "Operator Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="h4 mb-1">Operator Dashboard</h2>
        <p class="text-muted mb-0">Manage controlled documents, deviations, reports, and change requests.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- NEW DOCUMENT / SOP REQUEST -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="card-title mb-2">New Request</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Create and upload a new controlled document or SOP for supervisor approval.
                </p>
                <a href="/Documents/Create" class="btn btn-primary w-100 mt-3">
                    New Request &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- DEVIATION REQUEST -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="card-title mb-2">Deviation Request</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Raise a deviation against an active SOP or manufacturing procedure.
                </p>
                <a href="/Deviations/Index" class="btn btn-primary w-100 mt-3">
                    Deviation Request &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- DEVIATION REPORT -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="card-title mb-2">Deviation Report</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Submit a corrective action report and supporting evidence for an approved deviation.
                </p>
                <a href="/Deviations/Report" class="btn btn-primary w-100 mt-3">
                    Deviation Report &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- CHANGE REQUEST -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="card-title mb-2">Change Request</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Submit and track change requests for documents, software, or equipment.
                </p>
                <a href="/Operator/ChangeRequest" class="btn btn-primary w-100 mt-3">
                    Change Request &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- DOCUMENT LIST -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="card-title mb-2">Documents</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Browse controlled documents, check their status, and view document details.
                </p>
                <a asp-page="/Documents/Index" class="btn btn-primary w-100 mt-3">
                    View Documents &rarr;
                </a>
            </div>
        </div>
    </div>
</div>