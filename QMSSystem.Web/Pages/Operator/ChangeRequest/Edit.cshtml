@page
@model QMSSystem.Web.Pages.Operator.ChangeRequest.EditModel

@{
    ViewData["Title"] = "New Change Request";
}

<div class="container py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">QMS / OPERATOR</p>
            <h1 class="h3 mb-1">New Change Request</h1>
            <p class="text-muted mb-0">Submit a formal request for document or process modification.</p>
        </div>
        <a asp-page="/Operator/ChangeRequest/Index" class="btn btn-outline-secondary">
            &larr; Cancel &amp; Back
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <span class="fw-semibold">Change Request Details</span>
        </div>
        <div class="card-body">
            <form method="post" id="changeRequestForm" novalidate>
                <input type="hidden" asp-for="DocumentId" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="SelectedDeviationIds" class="form-label fw-semibold">
                            Associated Deviations (Document #@Model.DocumentId)
                        </label>
                        <select asp-for="SelectedDeviationIds" class="form-select" multiple size="4">
                            @foreach (var deviation in Model.Deviations)
                            {
                                <option value="@deviation.Id">
                                    #DEV-@deviation.Id - @deviation.Title
                                </option>
                            }
                        </select>
                        <div class="form-text">Hold Ctrl (Windows) or Cmd (Mac) to select multiple deviations if applicable.</div>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label fw-semibold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Enter change request title" required />
                        <span asp-validation-for="Title" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ChangeType" class="form-label fw-semibold">
                            Change Type <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ChangeType" class="form-select" required>
                            <option value="">-- Select Change Type --</option>
                            <option value="Equipment">Equipment</option>
                            <option value="Software">Software</option>
                            <option value="Process">Process</option>
                        </select>
                        <span asp-validation-for="ChangeType" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Description of Proposed Changes <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the proposed changes in detail..."
                                  required></textarea>
                        <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Requested By (User ID)</label>
                        <input asp-for="RequestedByUserId" class="form-control" readonly />
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Requested Date</label>
                        <input asp-for="RequestedDate" type="date" class="form-control" readonly />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="/Operator/ChangeRequest/Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    <button type="submit" id="submitChangeRequestBtn" class="btn btn-primary">
                        Submit Change Request
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var $form = $("#changeRequestForm");
            if ($form.length) {
                $form.validate({
                    rules: {
                        Title: {
                            required: true,
                            minlength: 3,
                            maxlength: 200
                        },
                        ChangeType: {
                            required: true
                        },
                        Description: {
                            required: true,
                            minlength: 10,
                            maxlength: 2000
                        }
                    },
                    messages: {
                        Title: {
                            required: "Please provide a title for the change request.",
                            minlength: "Title must be at least 3 characters.",
                            maxlength: "Title cannot exceed 200 characters."
                        },
                        ChangeType: {
                            required: "Please select a change type."
                        },
                        Description: {
                            required: "Please enter a detailed description of the proposed changes.",
                            minlength: "Description must be at least 10 characters.",
                            maxlength: "Description cannot exceed 2000 characters."
                        }
                    },
                    submitHandler: function (form) {
                        $("#submitChangeRequestBtn").prop("disabled", true).text("Submitting...");
                        form.submit();
                    }
                });
            }
        });
    </script>
}