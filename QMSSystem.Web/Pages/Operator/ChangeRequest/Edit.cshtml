@page
@model QMSSystem.Web.Pages.Operator.ChangeRequest.EditModel
@{
    ViewData["Title"] = "New Change Request";
}

<!-- PAGE HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pt-2">
    <div>
        <h2 class="h4 mb-1">New Change Request</h2>
        <p class="text-muted mb-0">Submit a formal request for document, software, or process modification.</p>
    </div>
    <a asp-page="/Operator/ChangeRequest/Index" class="btn btn-outline-secondary">
        &larr; Cancel &amp; Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <span class="fw-semibold">Change Request Details</span>
    </div>
    <div class="card-body">
        <form method="post" id="changeRequestForm" novalidate>
            <div class="row g-3">

                <!-- SELECTED DOCUMENT -->
                <div class="col-md-6">
                    <label asp-for="DocumentId" class="form-label fw-semibold">
                        Selected Document <span class="text-danger">*</span>
                    </label>
                    <input asp-for="DocumentId" type="hidden" />
                    <div class="form-control bg-light" aria-live="polite">
                        @(Model.SelectedDocumentTitle ?? "No document selected")
                    </div>
                    <span asp-validation-for="DocumentId" class="text-danger small d-block"></span>
                    @if (Model.DocumentId == 0)
                    {
                        <div class="form-text text-warning">
                            Select an active document from the
                            <a asp-page="/Operator/ChangeRequest/Documents">document list</a>.
                        </div>
                    }
                </div>

                <!-- CHANGE TYPE -->
                <div class="col-md-6">
                    <label asp-for="ChangeType" class="form-label fw-semibold">
                        Change Type <span class="text-danger">*</span>
                    </label>
                    <select asp-for="ChangeType" class="form-select" required>
                        <option value="">-- Select Change Type --</option>
                        <option value="Procedure">Procedure</option>
                        <option value="Equipment">Equipment</option>
                        <option value="Software">Software</option>
                        <option value="Process">Process</option>
                        <option value="Specification">Specification</option>
                    </select>
                    <span asp-validation-for="ChangeType" class="text-danger small d-block"></span>
                </div>

                <!-- TITLE -->
                <div class="col-12">
                    <label asp-for="Title" class="form-label fw-semibold">
                        Change Request Title <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="Brief summary of what needs to be changed..." maxlength="200" required />
                    <span asp-validation-for="Title" class="text-danger small d-block"></span>
                </div>

                <!-- ASSOCIATED DEVIATIONS -->
                <div class="col-12">
                    <label class="form-label fw-semibold" id="deviationsLabel">
                        Associated Deviations <span class="text-danger">*</span>
                    </label>
                    @if (Model.Deviations.Count > 0)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
                                    type="button"
                                    id="deviationDropdown"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                    aria-labelledby="deviationsLabel">
                                <span id="deviationDropdownLabel">Select associated deviations</span>
                            </button>
                            <div class="dropdown-menu w-100 p-2 deviation-multiselect-menu"
                                 aria-labelledby="deviationDropdown">
                                @foreach (var deviation in Model.Deviations)
                                {
                                    var checkboxId = $"deviation-{deviation.Id}";
                                    <label class="dropdown-item d-flex align-items-center gap-2 rounded"
                                           for="@checkboxId">
                                        <input class="form-check-input mt-0 deviation-checkbox"
                                               type="checkbox"
                                               name="SelectedDeviationIds"
                                               id="@checkboxId"
                                               value="@deviation.Id"
                                               checked="@Model.SelectedDeviationIds.Contains(deviation.Id)" />
                                        <span>#DEV-@deviation.Id - @deviation.Title</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <span asp-validation-for="SelectedDeviationIds"
                              id="deviationSelectionFeedback"
                              class="text-danger small d-block"></span>
                        <div class="form-text">Select one or more associated deviations.</div>
                    }
                    else
                    {
                        <div class="p-2 border rounded bg-light text-muted small" role="status">
                            No eligible deviations are available for this document. An associated deviation is required to submit a change request.
                        </div>
                    }
                </div>

                <!-- DESCRIPTION -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">
                        Description of Proposed Changes <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Detail the rationale, proposed solution, and affected sections..."
                              required></textarea>
                    <span asp-validation-for="Description" class="text-danger small d-block"></span>
                </div>

                <div class="col-sm-6">
                    <label class="form-label small text-muted">Requested By (User ID)</label>
                    <input asp-for="RequestedByUserId" class="form-control bg-light" readonly />
                </div>

                <div class="col-sm-6">
                    <label class="form-label small text-muted">Requested Date</label>
                    <input asp-for="RequestedDate" type="date" class="form-control bg-light" readonly />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-page="/Operator/ChangeRequest/Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
                <button type="submit" id="submitChangeRequestBtn" class="btn btn-primary px-4">
                    Submit Change Request
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("#documentSelect").on("change", function () {
                var docId = $(this).val();
                if (docId) {
                    window.location.href = window.location.pathname + "?documentId=" + docId;
                }
            });

            $("#changeRequestForm").validate({
                rules: {
                    DocumentId: { required: true, min: 1 },
                    Title: { required: true, maxlength: 200 },
                    ChangeType: { required: true },
                    Description: { required: true, minlength: 10 },
                    SelectedDeviationIds: { required: true }
                },
                messages: {
                    DocumentId: "Please select an active document.",
                    Title: "Please enter a change request title.",
                    ChangeType: "Please select a change type.",
                    Description: "Please provide a detailed description of the proposed changes.",
                    SelectedDeviationIds: "Select at least one associated deviation."
                },
                errorPlacement: function (error, element) {
                    if (element.attr("name") === "SelectedDeviationIds") {
                        error.appendTo("#deviationSelectionFeedback");
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            function updateDeviationSelection() {
                const selectedCount = $(".deviation-checkbox:checked").length;
                $("#deviationDropdownLabel").text(
                    selectedCount === 0
                        ? "Select associated deviations"
                        : `${selectedCount} deviation${selectedCount === 1 ? "" : "s"} selected`);
                $("#deviationSelectionFeedback").empty();
            }

            $(".deviation-checkbox").on("change", updateDeviationSelection);
            updateDeviationSelection();
        });
    </script>
}