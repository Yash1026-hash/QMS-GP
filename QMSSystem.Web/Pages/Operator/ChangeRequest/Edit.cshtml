@page
@model QMSSystem.Web.Pages.Operator.ChangeRequest.EditModel

<style>
    .change-request-form {
        max-width: 900px;
        margin: 30px auto;
    }

    .change-request-form h1 {
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
        font-size: 15px;
    }

    .form-group textarea {
        resize: vertical;
    }

    .submit-section {
        text-align: right;
        margin-top: 30px;
    }

    .submit-button {
        padding: 10px 25px;
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 15px;
        cursor: pointer;
    }

    .submit-button:hover {
        background-color: #0b5ed7;
    }
</style>

<div class="change-request-form">

    <h1>New Change Request</h1>

    <form method="post">

        <input type="hidden" asp-for="DocumentId" />

        <div class="form-group">

            <label>
                Select Deviations For Selected Document
            </label>

            <select asp-for="SelectedDeviationIds"
                    multiple
                    size="6">

                @foreach (var deviation in Model.Deviations)
                {
                    <option value="@deviation.Id">
                        @deviation.Id - @deviation.Title
                    </option>
                }

            </select>

        </div>

        <div class="form-group">
            <label>Title</label>

            <input asp-for="Title"
                   placeholder="Enter change request title" />
        </div>

        <div class="form-group">
            <label>Change Type</label>

            <select asp-for="ChangeType">
                <option value="">-- Select Change Type --</option>
                <option value="Equipment">Equipment</option>
                <option value="Software">Software</option>
                <option value="Process">Process</option>
            </select>
        </div>

        <div class="form-group">

            <label>Description of Proposed Changes</label>

            <textarea asp-for="Description"
                      rows="6">
            </textarea>

        </div>

        <div class="form-group">

            <label>Requested By</label>

            <input asp-for="RequestedByUserId"
                   readonly />

        </div>

        <div class="form-group">

            <label>Requested Date</label>

            <input asp-for="RequestedDate"
                   type="date"
                   readonly />

        </div>

        <div class="submit-section">

            <button type="submit"
                    class="submit-button">

                Submit

            </button>

        </div>

    </form>

</div>