@page
@model QMSSystem.Web.Pages.Operator.ChangeRequest.EditModel

<style>
    .change-request-form {
        max-width: 900px;
        margin: 30px auto;
    }

    .change-request-form h1 {
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
        font-size: 15px;
    }

    .form-group textarea {
        resize: vertical;
    }

    .submit-section {
        text-align: right;
        margin-top: 30px;
    }

    .submit-button {
        padding: 10px 25px;
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 15px;
        cursor: pointer;
    }

    .submit-button:hover {
        background-color: #0b5ed7;
    }
</style>

<div class="change-request-form">

    <h1>New Change Request</h1>

    <form method="post" id="changeRequestForm" novalidate>

        <input type="hidden" asp-for="DocumentId" />

        <div class="form-group">

            <label>
                Select Deviations For Selected Document
            </label>

            <select asp-for="SelectedDeviationIds"
                    multiple
                    size="6">

                @foreach (var deviation in Model.Deviations)
                {
                    <option value="@deviation.Id">
                        @deviation.Id - @deviation.Title
                    </option>
                }

            </select>

        </div>

        <div class="form-group">
            <label>Title <span class="text-danger">*</span></label>

            <input asp-for="Title"
                   placeholder="Enter change request title" />
            <span asp-validation-for="Title" class="invalid-feedback d-block"></span>
        </div>

        <div class="form-group">
            <label>Change Type <span class="text-danger">*</span></label>

            <select asp-for="ChangeType">
                <option value="">-- Select Change Type --</option>
                <option value="Equipment">Equipment</option>
                <option value="Software">Software</option>
                <option value="Process">Process</option>
            </select>
            <span asp-validation-for="ChangeType" class="invalid-feedback d-block"></span>
        </div>

        <div class="form-group">

            <label>Description of Proposed Changes <span class="text-danger">*</span></label>

            <textarea asp-for="Description"
                      rows="6"
                      placeholder="Describe the proposed changes in detail..."></textarea>
            <span asp-validation-for="Description" class="invalid-feedback d-block"></span>

        </div>

        <div class="form-group">

            <label>Requested By</label>

            <input asp-for="RequestedByUserId"
                   readonly />

        </div>

        <div class="form-group">

            <label>Requested Date</label>

            <input asp-for="RequestedDate"
                   type="date"
                   readonly />

        </div>

        <div class="submit-section">

            <button type="submit"
                    id="submitChangeRequestBtn"
                    class="submit-button">

                Submit

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var $form = $("#changeRequestForm");
            if ($form.length) {
                $form.validate({
                    rules: {
                        Title: {
                            required: true,
                            minlength: 3,
                            maxlength: 200
                        },
                        ChangeType: {
                            required: true
                        },
                        Description: {
                            required: true,
                            minlength: 10,
                            maxlength: 2000
                        }
                    },
                    messages: {
                        Title: {
                            required: "Please provide a title for the change request.",
                            minlength: "Title must be at least 3 characters.",
                            maxlength: "Title cannot exceed 200 characters."
                        },
                        ChangeType: {
                            required: "Please select a change type."
                        },
                        Description: {
                            required: "Please enter a detailed description of the proposed changes.",
                            minlength: "Description must be at least 10 characters.",
                            maxlength: "Description cannot exceed 2000 characters."
                        }
                    },
                    submitHandler: function (form) {
                        $("#submitChangeRequestBtn").prop("disabled", true).text("Submitting...");
                        form.submit();
                    }
                });
            }
        });
    </script>
}