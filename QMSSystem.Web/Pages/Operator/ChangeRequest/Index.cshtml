@page
@model QMSSystem.Web.Pages.Operator.ChangeRequestIndex.IndexModel

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
    }

    .add-button {
        background-color: #0d6efd;
        color: white;
        padding: 10px 16px;
        text-decoration: none;
        border-radius: 5px;
    }

    .add-button:hover {
        background-color: #0b5ed7;
    }

    .request-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
    }

    .request-table th,
    .request-table td {
        border: 1px solid #ddd;
        padding: 12px;
        text-align: left;
    }

    .request-table th {
        background-color: #f2f2f2;
    }

    .empty-message {
        text-align: center !important;
        color: #666;
        padding: 25px !important;
    }

    .details-frame {
        width: 100%;
        height: 70vh;
        border: none;
    }
</style>

<div class="page-header">
    <h1>My Change Requests</h1>

    <a href="/Operator/ChangeRequest/documents" class="add-button">
        + Add Request
    </a>
</div>

<table class="request-table">
    <thead>
        <tr>
            <th>Change Request</th>
            <th>Date</th>
            <th>Type</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.ChangeRequests.Count > 0)
        {
            @foreach (var request in Model.ChangeRequests)
            {
                <tr>
                    <td>@request.Title</td>

                    <td>
                        @request.RequestedDate.ToString("dd-MM-yyyy")
                    </td>

                    <td>@request.ChangeType</td>

                    <td>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#changeRequestModal-@request.Id">
                            View Details
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="empty-message">
                    No change requests found.
                </td>
            </tr>
        }
    </tbody>
</table>

@* Details popups - one for each Change Request *@
@if (Model.ChangeRequests.Count > 0)
{
    @foreach (var request in Model.ChangeRequests)
    {
        <div class="modal fade"
             id="changeRequestModal-@request.Id"
             tabindex="-1"
             aria-labelledby="changeRequestModalLabel-@request.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="changeRequestModalLabel-@request.Id">
                            Change Request Details
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body p-0">
                        <iframe
                            class="details-frame"
                            src="/Operator/ChangeRequests/Details/@request.Id"
                            title="Details for Change Request @request.Id">
                        </iframe>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
}