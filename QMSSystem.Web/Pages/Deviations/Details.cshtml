@page
@model QMSSystem.Web.Pages.Deviations.DetailsModel

@{
    ViewData["Title"] = "Deviation Details";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Deviation Details</h1>
            <p class="text-muted mb-0">
                View deviation information and uploaded proofs.
            </p>
        </div>

        <a asp-page="/Deviations/Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>


    <!-- Deviation Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Deviation Information</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">
                    <label class="fw-bold">
                        Deviation ID
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>
                </div>

                <div class="col-md-8">
                    <label class="fw-bold">
                        Title
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>
                </div>

            </div>


            <!-- Related SOP -->
            <div class="row mb-3">

                <div class="col-md-4">
                    <label class="fw-bold">
                        Related SOP
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>
                </div>

                <div class="col-md-8">
                    <label class="fw-bold">
                        SOP Title
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>
                </div>

            </div>


            <!-- Description -->
            <div class="mb-3">

                <label class="fw-bold">
                    Description
                </label>

                <div class="form-control bg-light"
                     style="min-height: 120px;">
                    -
                </div>

            </div>


            <!-- Severity / Raised By / Date -->
            <div class="row mb-3">

                <div class="col-md-4">

                    <label class="fw-bold">
                        Severity
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="fw-bold">
                        Raised By
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>

                </div>


                <div class="col-md-4">

                    <label class="fw-bold">
                        Issued Date
                    </label>

                    <div class="form-control bg-light">
                        -
                    </div>

                </div>

            </div>


            <!-- Status -->
            <div class="mb-2">

                <label class="fw-bold">
                    Status
                </label>

                <div>
                    <span class="badge bg-warning text-dark px-3 py-2">
                        Pending
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- Proofs -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Proofs</h5>
        </div>

        <div class="card-body">

            <div class="border rounded p-3 text-muted">
                No proofs uploaded.
            </div>

        </div>

    </div>


    <!-- Bottom Back Button -->
    <div class="d-flex justify-content-end mb-4">

        <a asp-page="/Deviations/Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>