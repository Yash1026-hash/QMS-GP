@page
@model QMSSystem.Web.Pages.Supervisor.IndexModel
@{
    ViewData["Title"] = "Supervisor Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="h4 mb-1">Supervisor Dashboard</h2>
        <p class="text-muted mb-0">Review and approve controlled documents, deviations, reports, and change requests.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- DOCUMENT REVIEW -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Document Review</h5>
                    @if (Model.PendingDocuments > 0)
                    {
                        <span class="badge bg-warning text-dark">@Model.PendingDocuments</span>
                    }
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Review and approve new controlled document and SOP uploads submitted by operators.
                </p>
                <a asp-page="/Supervisor/DocumentReview" class="btn btn-primary w-100 mt-3">
                    Document Review &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- DEVIATION REVIEW -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Deviation Review</h5>
                    @if (Model.PendingDeviations > 0)
                    {
                        <span class="badge bg-warning text-dark">@Model.PendingDeviations</span>
                    }
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Review and approve or reject active deviation requests submitted by operators.
                </p>
                <a asp-page="/Supervisor/DeviationReview" class="btn btn-primary w-100 mt-3">
                    Deviation Review &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- DEVIATION REPORT -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Deviation Report</h5>
                    @if (Model.PendingReports > 0)
                    {
                        <span class="badge bg-warning text-dark">@Model.PendingReports</span>
                    }
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Review completed corrective action reports and supporting evidence files.
                </p>
                <a asp-page="/Supervisor/DeviationReviewReport" class="btn btn-primary w-100 mt-3">
                    Deviation Report &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- CHANGE REQUEST -->
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 shadow-sm border">
            <div class="card-body d-flex flex-column p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">Change Request</h5>
                    @if (Model.PendingChangeRequests > 0)
                    {
                        <span class="badge bg-warning text-dark">@Model.PendingChangeRequests</span>
                    }
                </div>
                <p class="card-text text-muted small flex-grow-1">
                    Review and authorize operator change requests for documents, software, or equipment.
                </p>
                <a asp-page="/Supervisor/ChangeRequestApproval" class="btn btn-primary w-100 mt-3">
                    Change Request &rarr;
                </a>
            </div>
        </div>
    </div>
</div>