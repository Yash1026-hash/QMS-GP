@page
@model QMSSystem.Web.Pages.Supervisor.IndexModel

@{
    ViewData["Title"] = "Supervisor Dashboard";
}

<div class="container py-4">

    <!-- PAGE HEADING -->
    <div class="mb-4">
        <p class="eyebrow mb-1">QMS / SUPERVISOR</p>
        <h1 class="h3 mb-1">Supervisor Dashboard</h1>
        <p class="text-muted mb-0">Review and approve pending quality management activities.</p>
    </div>

    <!-- OPERATIONS GRID -->
    <div class="row g-4">

        <!-- DEVIATION REVIEW -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 card-title mb-0">Deviation Review</h2>
                        <span class="badge bg-primary fs-6">@Model.PendingDeviations</span>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Review and approve or reject pending deviation requests.
                    </p>
                    <a asp-page="/Supervisor/DeviationReview" class="btn btn-outline-primary w-100 mt-2">
                        Open Review &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- CHANGE REQUEST APPROVAL -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 card-title mb-0">Change Requests</h2>
                        <span class="badge bg-primary fs-6">@Model.PendingChangeRequests</span>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Review and approve or reject pending change requests.
                    </p>
                    <a asp-page="/Supervisor/ChangeRequestApproval" class="btn btn-outline-primary w-100 mt-2">
                        Open Approval &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- DEVIATION REVIEW REPORT -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 card-title mb-0">Deviation Reports</h2>
                        <span class="badge bg-primary fs-6">@Model.PendingReports</span>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Review submitted deviation reports and supporting proof.
                    </p>
                    <a asp-page="/Supervisor/DeviationReviewReport" class="btn btn-outline-primary w-100 mt-2">
                        Open Reports &rarr;
                    </a>
                </div>
            </div>
        </div>

        <!-- DOCUMENT REVIEW -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm border">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h5 card-title mb-0">Document Review</h2>
                        <span class="badge bg-primary fs-6">@Model.PendingDocuments</span>
                    </div>
                    <p class="card-text text-muted small flex-grow-1">
                        Review pending SOP documents and document revisions.
                    </p>
                    <a asp-page="/Supervisor/DocumentReview" class="btn btn-outline-primary w-100 mt-2">
                        Open Documents &rarr;
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>