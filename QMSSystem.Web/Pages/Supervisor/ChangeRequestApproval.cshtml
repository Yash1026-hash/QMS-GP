@page
@model QMSSystem.Web.Pages.Supervisor.ChangeRequestApprovalModel

@{
    ViewData["Title"] = "Change Request Approval";
}

<!-- PAGE HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="h4 mb-1">Change Request Approval</h2>
        <p class="text-muted mb-0">Review and approve pending change requests.</p>
    </div>
    <a asp-page="/Supervisor/Index" class="btn btn-outline-secondary">
        &larr; Back to Supervisor Home
    </a>
</div>


    <!-- ERROR MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] is string successMsg || !string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @(TempData["SuccessMessage"] ?? Model.SuccessMessage)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- CHANGE REQUEST TABLE -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="card-title mb-3">
                Change Requests Awaiting Approval
            </h5>


            @if (Model.ChangeRequests != null &&
                 Model.ChangeRequests.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Request ID</th>
                                <th>Title</th>
                                <th>Document ID</th>
                                <th>Change Type</th>
                                <th>Requested By</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var request in Model.ChangeRequests)
                            {
                                <tr>

                                    <td>
                                        @request.Id
                                    </td>

                                    <td>
                                        @request.Title
                                    </td>

                                    <td>
                                        @request.DocumentId
                                    </td>

                                    <td>
                                        @request.ChangeType
                                    </td>

                                    <td>
                                        @request.RequestedByUserId
                                    </td>

                                    <td>

                                        <span class="badge bg-warning text-dark">
                                            @request.Status
                                        </span>

                                    </td>

                                    <td>

                                        <!-- REVIEW BUTTON -->
                                        <button type="button"
                                                class="btn btn-primary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#changeRequestModal-@request.Id">
                                            Review
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">

                    No pending change requests are available for approval.

                </div>
            }

        </div>

    </div>

    <!-- CLOSED / HISTORICAL CHANGE REQUESTS TABLE -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="card-title mb-3">
                Closed &amp; Historical Requests (@Model.ClosedChangeRequests.Count)
            </h5>
            @if (Model.ClosedChangeRequests != null && Model.ClosedChangeRequests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Request ID</th>
                                <th>Title</th>
                                <th>Document ID</th>
                                <th>Change Type</th>
                                <th>Requested By</th>
                                <th>Decision</th>
                                <th>Closed Date</th>
                                <th>Supervisor Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var closed in Model.ClosedChangeRequests)
                            {
                                <tr>
                                    <td class="fw-semibold">#CR-@closed.Id</td>
                                    <td>
                                        <div class="fw-medium">@closed.Title</div>
                                        <div class="small text-muted text-truncate" style="max-width: 280px;">@closed.Description</div>
                                    </td>
                                    <td>#DOC-@closed.DocumentId</td>
                                    <td><span class="badge bg-secondary">@closed.ChangeType</span></td>
                                    <td>User #@closed.RequestedByUserId</td>
                                    <td>
                                        <span class="badge @(closed.Decision switch {
                                            "Approved" or "Accepted" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            _ => "bg-secondary"
                                        })">
                                            @(string.IsNullOrWhiteSpace(closed.Decision) ? "Closed" : closed.Decision)
                                        </span>
                                    </td>
                                    <td>@(closed.DecisionDate?.ToString("yyyy-MM-dd HH:mm") ?? closed.RequestedDate.ToString("yyyy-MM-dd"))</td>
                                    <td class="small text-muted">
                                        @(string.IsNullOrWhiteSpace(closed.DecisionComment) ? "-" : closed.DecisionComment)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted small py-2">
                    No closed change requests recorded yet.
                </div>
            }
        </div>
    </div>

<!-- ========================================================= -->
<!-- CHANGE REQUEST MODALS                                     -->
<!-- ========================================================= -->

@if (Model.ChangeRequests != null &&
     Model.ChangeRequests.Any())
{
    foreach (var request in Model.ChangeRequests)
    {
        <div class="modal fade"
             id="changeRequestModal-@request.Id"
             tabindex="-1"
             aria-labelledby="changeRequestModalLabel-@request.Id"
             aria-hidden="true">

            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

                <div class="modal-content">


                    <!-- MODAL HEADER -->
                    <div class="modal-header">

                        <div>

                            <small class="text-muted">
                                Change Request #@request.Id
                            </small>

                            <h4 class="modal-title mt-1"
                                id="changeRequestModalLabel-@request.Id">

                                @request.Title

                            </h4>

                        </div>


                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>


                    <!-- MODAL BODY -->
                    <div class="modal-body">


                        <!-- BASIC INFORMATION -->
                        <div class="row mb-4">

                            <div class="col-md-6">

                                <strong>
                                    Document ID
                                </strong>

                                <div class="mt-1">
                                    @request.DocumentId
                                </div>

                            </div>


                            <div class="col-md-6">

                                <strong>
                                    Change Type
                                </strong>

                                <div class="mt-1">
                                    @request.ChangeType
                                </div>

                            </div>

                        </div>


                        <div class="row mb-4">

                            <div class="col-md-6">

                                <strong>
                                    Requested By
                                </strong>

                                <div class="mt-1">
                                    @request.RequestedByUserId
                                </div>

                            </div>


                            <div class="col-md-6">

                                <strong>
                                    Requested Date
                                </strong>

                                <div class="mt-1">

                                    @request.RequestedDate.ToString(
                                        "dd-MM-yyyy HH:mm")

                                </div>

                            </div>

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <strong>
                                Description
                            </strong>

                            <div class="border rounded p-3 mt-2 bg-light">

                                @request.Description

                            </div>

                        </div>


                        <hr />


                        <!-- APPROVAL SECTION -->
                        <h5 class="mb-3">
                            Approval Decision
                        </h5>


                        <form method="post" class="change-request-approval-form" tabindex="-1" novalidate>

                            <!-- CHANGE REQUEST ID -->
                            <input type="hidden"
                                   name="ChangeRequestId"
                                   value="@request.Id" />


                            <!-- DECISION -->
                            <div class="mb-4">

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Decision"
                                           value="approve"
                                           id="accept-@request.Id"
                                           required />
                                    <label class="form-check-label"
                                           for="accept-@request.Id">
                                        Approve
                                    </label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Decision"
                                           value="reject"
                                           id="reject-@request.Id" />
                                    <label class="form-check-label"
                                           for="reject-@request.Id">
                                        Reject
                                    </label>
                                </div>

                            </div>


                            <!-- COMMENTS -->
                            <div class="mb-3">

                                <label class="form-label">

                                    Reviewer Comments <span class="text-danger">*</span>

                                </label>


                                <textarea class="form-control"
                                          name="DecisionComment"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Enter comments for the requester"
                                          required></textarea>

                            </div>


                            <!-- MODAL FOOTER -->
                            <div class="modal-footer px-0 pb-0">

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">

                                    Close

                                </button>


                                <button type="submit"
                                        class="btn btn-primary submit-approval-btn">

                                    Submit

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".modal[id^='changeRequestModal-']").on("shown.bs.modal", function () {
                var form = this.querySelector(".change-request-approval-form");
                if (form) {
                    form.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            });

            $(".change-request-approval-form").each(function () {
                $(this).validate({
                    rules: {
                        Decision: {
                            required: true
                        },
                        DecisionComment: {
                            required: true,
                            minlength: 3,
                            maxlength: 1000
                        }
                    },
                    messages: {
                        Decision: {
                            required: "Please select an approval decision (Approve or Reject)."
                        },
                        DecisionComment: {
                            required: "Please enter reviewer comments.",
                            minlength: "Comments must be at least 3 characters.",
                            maxlength: "Comments cannot exceed 1000 characters."
                        }
                    },
                    errorPlacement: function (error, element) {
                        if (element.attr("type") === "radio") {
                            error.insertAfter(element.closest(".mb-4"));
                        } else {
                            error.insertAfter(element);
                        }
                    },
                    submitHandler: function (form) {
                        $(form).find("button[type='submit']").prop("disabled", true).text("Submitting...");
                        form.submit();
                    }
                });
            });
        });
    </script>
}