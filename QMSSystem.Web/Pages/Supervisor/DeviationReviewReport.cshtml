
@page
@model QMSSystem.Web.Pages.Supervisor.DeviationReviewReportModel

@{
    ViewData["Title"] = "Deviation Review Report";
}

<link rel="stylesheet"
      href="~/css/supervisor.css"
      asp-append-version="true" />

<div class="operation-page">
    <div class="operation-container">

        <!-- Page heading -->
        <div class="supervisor-heading mb-4">
            <div class="small-title">QMS</div>
            <h1>
                @(Model.ReportId > 0 ? "Deviation Report Details" : "Submitted Deviation Reports")
            </h1>
            <p>
                @(Model.ReportId > 0
                    ? "Review the submitted report and record your decision."
                    : "View and review deviation reports submitted by operators.")
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.ReportId <= 0)
        {
            <div class="review-card">
                <div class="card-heading">
                    <h4 class="section-title">Submitted Reports</h4>
                    <div class="section-description">
                        Reports are listed with the most recently submitted first.
                    </div>
                </div>

                @if (Model.Reports.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover reports-table mb-0">
                            <thead>
                                <tr>
                                    <th>Report ID</th>
                                    <th>Deviation ID</th>
                                    <th>Document ID</th>
                                    <th>Submitted By</th>
                                    <th>Submitted Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.Reports)
                                {
                                    <tr>
                                        <td>@report.Id</td>
                                        <td>@report.DeviationId</td>
                                        <td>@report.DocumentId</td>
                                        <td>@(string.IsNullOrWhiteSpace(report.CreatedBy) ? "Unknown" : report.CreatedBy)</td>
                                        <td>@report.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td>
                                            @if (report.Status == 1)
                                            {
                                                <span class="status-badge status-approved">Approved</span>
                                            }
                                            else if (report.Status == 2)
                                            {
                                                <span class="status-badge status-rejected">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">Pending Review</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Supervisor/DeviationReviewReport"
                                               asp-route-ReportId="@report.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="card-body text-center text-muted">
                        No deviation reports have been submitted yet.
                    </div>
                }
            </div>
        }
        else if (Model.Report.Id > 0)
        {
            <div class="review-card">

                <div class="card-heading">
                    <div class="report-detail-heading">
                        <div>
                            <h2 class="section-title">Deviation Report Details</h2>
                            <p class="section-description">
                                Report information submitted by the operator.
                            </p>
                        </div>
                        <a asp-page="/Supervisor/DeviationReviewReport"
                           class="btn btn-outline-secondary btn-sm report-back-button">
                            Back to Reports
                        </a>
                    </div>
                </div>

                <div class="card-body">

                    <section class="report-info-box report-primary-box">
                        <h5 class="report-box-title">Report details</h5>
                        <p class="section-description">The submitted investigation and the related deviation.</p>

                        <div class="report-details-grid">
                            <div class="report-detail-item">
                                <label class="field-label">Report ID</label>
                                <div class="field-value">@Model.Report.Id</div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">Deviation ID</label>
                                <div class="field-value">@Model.Report.DeviationId</div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">SOP document ID</label>
                                <div class="field-value">@Model.Report.DocumentId</div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">Attempt number</label>
                                <div class="field-value">@Model.Report.AttemptNumber</div>
                            </div>
                            <div class="report-detail-item report-summary-item">
                                <label class="field-label">Summary</label>
                                <div class="field-value">@(string.IsNullOrWhiteSpace(Model.Report.Summary) ? "No summary provided." : Model.Report.Summary)</div>
                            </div>
                        </div>
                    </section>

                    <section class="report-info-box report-meta-box">
                        <h5 class="report-box-title">Submission and status</h5>
                        <p class="section-description">Submission information and current review state.</p>

                        <div class="report-details-grid">
                            <div class="report-detail-item">
                                <label class="field-label">Submitted by</label>
                                <div class="field-value">
                                    @(string.IsNullOrWhiteSpace(Model.Report.CreatedBy)
                                        ? "Unknown"
                                        : Model.Report.CreatedBy)
                                </div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">Submission date</label>
                                <div class="field-value">@Model.Report.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">Proof attachment</label>
                                <div class="field-value">
                                    @(Model.Report.Proof is { Length: > 0 }
                                        ? "Proof data is attached."
                                        : "No proof attached.")
                                </div>
                                <div class="proof-note">Attachment presence is shown; this page does not display or download it.</div>
                            </div>
                            <div class="report-detail-item">
                                <label class="field-label">Review status</label>
                                <div class="field-value">
                                    @if (Model.Report.Decision == 1)
                                    {
                                        <span class="status-badge status-approved">Approved</span>
                                    }
                                    else if (Model.Report.Decision == 2)
                                    {
                                        <span class="status-badge status-rejected">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending review</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>

                    <h5 class="fw-bold mb-3">Supervisor Decision</h5>

                    @if (Model.Report.Decision == 1 ||
                         Model.Report.Decision == 2)
                    {
                        <div class="alert @(Model.Report.Decision == 1
                            ? "alert-success"
                            : "alert-danger")">
                            <strong>
                                @(Model.Report.Decision == 1
                                    ? "Report Approved"
                                    : "Report Rejected")
                            </strong>

                            <div class="mt-2">
                                Decision by:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionBy)
                                    ? "Unknown"
                                    : Model.Report.DecisionBy)
                            </div>

                            @if (Model.Report.DecisionOn.HasValue)
                            {
                                <div>
                                    Decision date:
                                    @Model.Report.DecisionOn.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            }

                            <div class="mt-2">
                                Comments:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionComments)
                                    ? "No comments provided."
                                    : Model.Report.DecisionComments)
                            </div>
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <input type="hidden" asp-for="Report.Id" />
                            <input type="hidden" asp-for="Report.DeviationId" />
                            <input type="hidden" asp-for="ReportId" />

                            <div class="mb-3">
                                <label asp-for="DecisionComments"
                                       class="form-label field-label">
                                    Supervisor Comments
                                </label>

                                <textarea asp-for="DecisionComments"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter review comments"></textarea>
                            </div>

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <span class="form-label field-label d-block">Decision</span>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="Decision"
                                           value="1"
                                           id="decisionApprove" />
                                    <label class="form-check-label" for="decisionApprove">
                                        Approve
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="Decision"
                                           value="2"
                                           id="decisionReject" />
                                    <label class="form-check-label" for="decisionReject">
                                        Reject
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary decision-button">
                                Submit
                            </button>
                        </form>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DecisionMessage))
                    {
                        <div class="alert alert-success mt-3" role="status">
                            @Model.DecisionMessage
                        </div>
                    }

                </div>
            </div>
        }
        else
        {
            <div class="review-card">
                <div class="card-body">
                    <p class="mb-3">The selected report could not be loaded.</p>
                    <a asp-page="/Supervisor/DeviationReviewReport"
                       class="btn btn-outline-secondary">
                        Back to Reports
                    </a>
                </div>
            </div>
        }
    </div>
</div>