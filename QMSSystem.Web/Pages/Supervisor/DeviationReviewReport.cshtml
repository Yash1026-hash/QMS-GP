
@page
@model QMSSystem.Web.Pages.Supervisor.DeviationReviewReportModel

@{
    ViewData["Title"] = "Deviation Review Report";
}

<style>
    .review-page {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 32px 24px;
    }

    .review-card {
        background-color: #fff;
        border: 1px solid #e1e8ef;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(31, 52, 73, 0.05);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-heading {
        background-color: #fff;
        border-bottom: 1px solid #e7edf3;
        padding: 20px 24px;
    }

    .review-card > .card-body {
        padding: 24px;
    }

    .field-label {
        color: #263b53;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .field-value {
        background: #f7f9fb;
        border: 1px solid #dce5ed;
        border-radius: 6px;
        min-height: 42px;
        padding: 10px 12px;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .section-description {
        color: #6b7d91;
        font-size: 14px;
    }

    .status-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background: #fff3cd;
        color: #795900;
    }

    .status-approved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-rejected {
        background: #f8d7da;
        color: #842029;
    }

    .decision-button {
        min-width: 130px;
    }

    .proof-note {
        color: #6b7d91;
        font-size: 13px;
        line-height: 1.4;
    }

    .reports-table th {
        background: #f7f9fb;
        color: #263b53;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .reports-table td {
        vertical-align: middle;
    }

    @@media (max-width: 768px) {
        .review-page {
            padding: 20px 12px;
        }

        .card-heading {
            padding: 18px 16px;
        }

        .review-card > .card-body {
            padding: 18px 16px;
        }

        .decision-button {
            width: 100%;
            margin: 5px 0;
        }
    }
</style>

<div class="review-page">
    <div class="container">

        <!-- Page heading -->
        <div class="mb-4">
            <h2 class="fw-bold">
                @(Model.ReportId > 0 ? "Deviation Report Details" : "Submitted Deviation Reports")
            </h2>
            <p class="text-muted">
                @(Model.ReportId > 0
                    ? "Review the submitted report and record your decision."
                    : "View and review deviation reports submitted by operators.")
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.ReportId <= 0)
        {
            <div class="review-card">
                <div class="card-heading">
                    <h4 class="section-title">Submitted Reports</h4>
                    <div class="section-description">
                        Reports are listed with the most recently submitted first.
                    </div>
                </div>

                @if (Model.Reports.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover reports-table mb-0">
                            <thead>
                                <tr>
                                    <th>Report ID</th>
                                    <th>Deviation ID</th>
                                    <th>Document ID</th>
                                    <th>Submitted By</th>
                                    <th>Submitted Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.Reports)
                                {
                                    <tr>
                                        <td>@report.Id</td>
                                        <td>@report.DeviationId</td>
                                        <td>@report.DocumentId</td>
                                        <td>@(string.IsNullOrWhiteSpace(report.CreatedBy) ? "Unknown" : report.CreatedBy)</td>
                                        <td>@report.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td>
                                            @if (report.Status == 1)
                                            {
                                                <span class="status-badge status-approved">Approved</span>
                                            }
                                            else if (report.Status == 2)
                                            {
                                                <span class="status-badge status-rejected">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">Pending Review</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Supervisor/DeviationReviewReport"
                                               asp-route-ReportId="@report.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="card-body text-center text-muted">
                        No deviation reports have been submitted yet.
                    </div>
                }
            </div>
        }
        else if (Model.Report.Id > 0)
        {
            <div class="review-card">

                <div class="card-heading">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h4 class="section-title">Deviation Report Details</h4>
                            <div class="section-description">
                                Report information submitted by the operator.
                            </div>
                        </div>
                        <a asp-page="/Supervisor/DeviationReviewReport"
                           class="btn btn-outline-secondary btn-sm">
                            Back to Reports
                        </a>
                    </div>
                </div>

                <div class="card-body">

                    <!-- Deviation information -->
                    <h5 class="fw-bold mb-3">Deviation and SOP Information</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="field-label">Deviation ID</label>
                            <div class="field-value">
                                @Model.Report.DeviationId
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">SOP Document ID</label>
                            <div class="field-value">
                                @Model.Report.DocumentId
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Deviation Report ID</label>
                            <div class="field-value">
                                @Model.Report.Id
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Attempt Number</label>
                            <div class="field-value">
                                @Model.Report.AttemptNumber
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Submitted report -->
                    <h5 class="fw-bold mb-3">Submitted Report</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="field-label">Summary</label>
                            <div class="field-value">
                                @if (string.IsNullOrWhiteSpace(Model.Report.Summary))
                                {
                                    <span class="text-muted">
                                        No summary provided.
                                    </span>
                                }
                                else
                                {
                                    @Model.Report.Summary
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Submitted By</label>
                            <div class="field-value">
                                @(string.IsNullOrWhiteSpace(Model.Report.CreatedBy)
                                    ? "Unknown"
                                    : Model.Report.CreatedBy)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Submission Date</label>
                            <div class="field-value">
                                @Model.Report.CreatedDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Proof Attachment</label>
                            <div class="field-value">
                                @if (Model.Report.Proof is { Length: > 0 })
                                {
                                    <span>Proof data is attached to this report.</span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No proof attached.
                                    </span>
                                }
                            </div>
                            <div class="proof-note mt-1">
                                This section indicates whether proof data exists;
                                it does not download or display the file.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Review Status</label>
                            <div class="field-value">
                                @if (Model.Report.Decision == 1)
                                {
                                    <span class="status-badge status-approved">
                                        Approved
                                    </span>
                                }
                                else if (Model.Report.Decision == 2)
                                {
                                    <span class="status-badge status-rejected">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        Pending Review
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <h5 class="fw-bold mb-3">Supervisor Decision</h5>

                    @if (Model.Report.Decision == 1 ||
                         Model.Report.Decision == 2)
                    {
                        <div class="alert @(Model.Report.Decision == 1
                            ? "alert-success"
                            : "alert-danger")">
                            <strong>
                                @(Model.Report.Decision == 1
                                    ? "Report Approved"
                                    : "Report Rejected")
                            </strong>

                            <div class="mt-2">
                                Decision by:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionBy)
                                    ? "Unknown"
                                    : Model.Report.DecisionBy)
                            </div>

                            @if (Model.Report.DecisionOn.HasValue)
                            {
                                <div>
                                    Decision date:
                                    @Model.Report.DecisionOn.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            }

                            <div class="mt-2">
                                Comments:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionComments)
                                    ? "No comments provided."
                                    : Model.Report.DecisionComments)
                            </div>
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <input type="hidden" asp-for="Report.Id" />
                            <input type="hidden" asp-for="Report.DeviationId" />
                            <input type="hidden" asp-for="ReportId" />

                            <div class="mb-3">
                                <label asp-for="DecisionComments"
                                       class="form-label field-label">
                                    Supervisor Comments
                                </label>

                                <textarea asp-for="DecisionComments"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter review comments"></textarea>
                            </div>

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <span class="form-label field-label d-block">Decision</span>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="Decision"
                                           value="1"
                                           id="decisionApprove" />
                                    <label class="form-check-label" for="decisionApprove">
                                        Approve
                                    </label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="Decision"
                                           value="2"
                                           id="decisionReject" />
                                    <label class="form-check-label" for="decisionReject">
                                        Reject
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary decision-button">
                                Submit
                            </button>
                        </form>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DecisionMessage))
                    {
                        <div class="alert alert-success mt-3" role="status">
                            @Model.DecisionMessage
                        </div>
                    }

                </div>
            </div>
        }
        else
        {
            <div class="review-card">
                <div class="card-body">
                    <p class="mb-3">The selected report could not be loaded.</p>
                    <a asp-page="/Supervisor/DeviationReviewReport"
                       class="btn btn-outline-secondary">
                        Back to Reports
                    </a>
                </div>
            </div>
        }
    </div>
</div>