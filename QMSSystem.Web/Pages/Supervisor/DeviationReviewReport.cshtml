
@page
@model QMSSystem.Web.Pages.Supervisor.DeviationReviewReportModel

@{
    ViewData["Title"] = "Deviation Review Report";
}

<style>
    .review-page {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 32px 24px;
    }

    .review-card {
        background-color: #fff;
        border: 1px solid #e1e8ef;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(31, 52, 73, 0.05);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-heading {
        background-color: #fff;
        border-bottom: 1px solid #e7edf3;
        padding: 20px 24px;
    }

    .review-card > .card-body {
        padding: 24px;
    }

    .search-button {
        background: #167e8d;
        border-color: #167e8d;
        color: #fff;
        min-width: 180px;
    }

    .search-button:hover {
        background: #116775;
        border-color: #116775;
        color: #fff;
    }

    .field-label {
        color: #263b53;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .field-value {
        background: #f7f9fb;
        border: 1px solid #dce5ed;
        border-radius: 6px;
        min-height: 42px;
        padding: 10px 12px;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .section-description {
        color: #6b7d91;
        font-size: 14px;
    }

    .status-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-pending {
        background: #fff3cd;
        color: #795900;
    }

    .status-approved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-rejected {
        background: #f8d7da;
        color: #842029;
    }

    .decision-button {
        min-width: 130px;
    }

    .proof-note {
        color: #6b7d91;
        font-size: 13px;
        line-height: 1.4;
    }

    @@media (max-width: 768px) {
        .review-page {
            padding: 20px 12px;
        }

        .card-heading {
            padding: 18px 16px;
        }

        .review-card > .card-body {
            padding: 18px 16px;
        }

        .search-button {
            width: 100%;
        }

        .decision-button {
            width: 100%;
            margin: 5px 0;
        }
    }
</style>

<div class="review-page">
    <div class="container">

        <!-- Page heading -->
        <div class="mb-4">
            <h2 class="fw-bold">Deviation Review Report</h2>
            <p class="text-muted">
                Search by Deviation ID to view the submitted report and its review status.
            </p>
        </div>

        <!-- Search section -->
        <div class="review-card">
            <div class="card-body">
                <form method="get">
                    <div class="row align-items-end g-3">
                        <div class="col-md-8">
                            <label asp-for="Search"
                                   class="form-label field-label">
                                Deviation ID
                            </label>

                            <input asp-for="Search"
                                   type="number"
                                   min="1"
                                   class="form-control form-control-lg"
                                   placeholder="Enter Deviation ID"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn search-button btn-lg w-100">
                                Search Report
                            </button>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.SearchMessage))
                {
                    <div class="alert alert-info mt-3 mb-0" role="status">
                        @Model.SearchMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        @Model.ErrorMessage
                    </div>
                }
            </div>
        </div>

        <!-- Report details -->
        @if (Model.Report.Id > 0)
        {
            <div class="review-card">

                <div class="card-heading">
                    <h4 class="section-title">Deviation Report Details</h4>
                    <div class="section-description">
                        Report information submitted by the operator.
                    </div>
                </div>

                <div class="card-body">

                    <!-- Deviation information -->
                    <h5 class="fw-bold mb-3">Deviation and SOP Information</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="field-label">Deviation ID</label>
                            <div class="field-value">
                                @Model.Report.DeviationId
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">SOP Document ID</label>
                            <div class="field-value">
                                @Model.Report.DocumentId
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Deviation Report ID</label>
                            <div class="field-value">
                                @Model.Report.Id
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Attempt Number</label>
                            <div class="field-value">
                                @Model.Report.AttemptNumber
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Submitted report -->
                    <h5 class="fw-bold mb-3">Submitted Report</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="field-label">Summary</label>
                            <div class="field-value">
                                @if (string.IsNullOrWhiteSpace(Model.Report.Summary))
                                {
                                    <span class="text-muted">
                                        No summary provided.
                                    </span>
                                }
                                else
                                {
                                    @Model.Report.Summary
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Submitted By</label>
                            <div class="field-value">
                                @(string.IsNullOrWhiteSpace(Model.Report.CreatedBy)
                                    ? "Unknown"
                                    : Model.Report.CreatedBy)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Submission Date</label>
                            <div class="field-value">
                                @Model.Report.CreatedDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Proof Attachment</label>
                            <div class="field-value">
                                @if (Model.Report.Proof is { Length: > 0 })
                                {
                                    <span>Proof data is attached to this report.</span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No proof attached.
                                    </span>
                                }
                            </div>
                            <div class="proof-note mt-1">
                                This section indicates whether proof data exists;
                                it does not download or display the file.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Review Status</label>
                            <div class="field-value">
                                @if (Model.Report.Decision == 1)
                                {
                                    <span class="status-badge status-approved">
                                        Approved
                                    </span>
                                }
                                else if (Model.Report.Decision == 2)
                                {
                                    <span class="status-badge status-rejected">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        Pending Review
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Supervisor decision -->
                    <h5 class="fw-bold mb-3">Supervisor Decision</h5>

                    @if (Model.Report.Decision == 1 ||
                         Model.Report.Decision == 2)
                    {
                        <div class="alert @(Model.Report.Decision == 1
                            ? "alert-success"
                            : "alert-danger")">

                            <strong>
                                @(Model.Report.Decision == 1
                                    ? "Report Approved"
                                    : "Report Rejected")
                            </strong>

                            <div class="mt-2">
                                Decision by:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionBy)
                                    ? "Unknown"
                                    : Model.Report.DecisionBy)
                            </div>

                            @if (Model.Report.DecisionOn.HasValue)
                            {
                                <div>
                                    Decision date:
                                    @Model.Report.DecisionOn.Value
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            }

                            <div class="mt-2">
                                Comments:
                                @(string.IsNullOrWhiteSpace(Model.Report.DecisionComments)
                                    ? "No comments provided."
                                    : Model.Report.DecisionComments)
                            </div>
                        </div>

                        @if (Model.Report.Decision == 1)
                        {
                            <p class="text-muted small mb-0">
                                The submitted report details are available above.
                            </p>
                        }
                    }
                    else
                    {
                        <form method="post">
                            <input type="hidden" asp-for="Report.Id" />
                            <input type="hidden" asp-for="Report.DeviationId" />

                            <div class="mb-3">
                                <label asp-for="DecisionComments"
                                       class="form-label field-label">
                                    Supervisor Comments
                                </label>

                                <textarea asp-for="DecisionComments"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter review comments"></textarea>
                            </div>

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <button type="submit"
                                    name="Decision"
                                    value="1"
                                    class="btn btn-success decision-button me-2">
                                Approve
                            </button>

                            <button type="submit"
                                    name="Decision"
                                    value="2"
                                    class="btn btn-danger decision-button">
                                Reject
                            </button>
                        </form>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DecisionMessage))
                    {
                        <div class="alert alert-success mt-3" role="status">
                            @Model.DecisionMessage
                        </div>
                    }

                </div>
            </div>
        }
    </div>
</div>