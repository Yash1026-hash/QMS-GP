@page
@model QMSSystem.Web.Pages.Supervisor.DeviationReviewModel

@{
    ViewData["Title"] = "Deviation Review";
}

<link rel="stylesheet" href="~/css/supervisor.css" />

<div class="operation-page">

    <div class="operation-container">

        <h1>Deviation Review</h1>

        <p class="operation-description">
            Review and approve or reject pending deviation requests.
        </p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="operation-message">
                @Model.Message
            </div>
        }

        <!-- Search Section -->
        <div class="review-section">

            <h3>Search Deviation</h3>

            <form method="get" id="deviationReviewSearchForm">

                <label asp-for="SearchId">
                    Deviation ID
                </label>

                <input asp-for="SearchId"
                       type="number"
                       min="1"
                       placeholder="Enter deviation ID"
                       required />

                <button type="submit">
                    Search
                </button>

            </form>

        </div>


        <!-- Deviation Details -->
        @if (Model.Deviation != null)
        {
            <div class="review-section">

                <h3>Deviation Details</h3>

                <div class="deviation-details">

                    <p>
                        <strong>ID:</strong>
                        @Model.Deviation.Id
                    </p>

                    <p>
                        <strong>Title:</strong>
                        @Model.Deviation.Title
                    </p>

                    <p>
                        <strong>Description:</strong>
                        @Model.Deviation.Description
                    </p>

                    <p>
                        <strong>Document ID:</strong>
                        @Model.Deviation.DocumentId
                    </p>

                    <p>
                        <strong>Priority:</strong>
                        @Model.Deviation.Priority
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @Model.Deviation.Status
                    </p>

                    <p>
                        <strong>Created By:</strong>
                        @Model.Deviation.CreatedBy
                    </p>

                    <p>
                        <strong>Created Date:</strong>
                        @Model.Deviation.CreatedDate
                    </p>

                </div>


                <!-- Approval Section -->
                @if (Model.Deviation.Status == 0)
                {
                    <div class="approval-section">

                        <h3>Supervisor Decision</h3>

                        <form method="post" id="deviationDecisionForm" novalidate>

                            <input type="hidden"
                                   asp-for="Approval.DeviationRequestId" />

                            <label asp-for="Approval.DecisionComments">
                                Comments <span class="text-danger">*</span>
                            </label>

                            <textarea asp-for="Approval.DecisionComments"
                                      rows="5"
                                      placeholder="Enter your comments"></textarea>
                            <span asp-validation-for="Approval.DecisionComments" class="text-danger small d-block mb-2"></span>

                            <div class="approval-buttons">

                                <button type="submit"
                                        id="approveBtn"
                                        asp-page-handler="Approve">
                                    Approve
                                </button>

                                <button type="submit"
                                        id="rejectBtn"
                                        asp-page-handler="Reject">
                                    Reject
                                </button>

                            </div>

                        </form>

                    </div>
                }
                else
                {
                    <div class="operation-message">

                        This deviation has already been processed and
                        cannot be reviewed again.

                    </div>
                }

            </div>
        }

        <a asp-page="/Supervisor/Index"
           class="back-button">

            ← Back to Supervisor Home

        </a>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var $searchForm = $("#deviationReviewSearchForm");
            if ($searchForm.length) {
                $searchForm.validate({
                    rules: {
                        SearchId: {
                            required: true,
                            min: 1
                        }
                    },
                    messages: {
                        SearchId: {
                            required: "Please enter a deviation ID to search.",
                            min: "Deviation ID must be greater than 0."
                        }
                    }
                });
            }

            var $decisionForm = $("#deviationDecisionForm");
            if ($decisionForm.length) {
                $decisionForm.validate({
                    rules: {
                        "Approval.DecisionComments": {
                            required: true,
                            minlength: 3,
                            maxlength: 1000
                        }
                    },
                    messages: {
                        "Approval.DecisionComments": {
                            required: "Please provide supervisor review comments before submitting.",
                            minlength: "Comments must be at least 3 characters.",
                            maxlength: "Comments cannot exceed 1000 characters."
                        }
                    }
                });
            }
        });
    </script>
}