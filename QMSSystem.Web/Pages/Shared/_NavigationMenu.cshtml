<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm" aria-label="Main navigation">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2"
           asp-area=""
           asp-page="/Index"
           aria-label="QMS home">
            <span class="brand-mark" aria-hidden="true">QMS</span>
            <span>QMS</span>
        </a>

        <div class="navbar-nav ms-auto align-items-lg-center">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="nav-link user-name">
                    @User.Identity.Name
                </span>

                @if (User.IsInRole("Admin"))
                {
                    <span class="badge rounded-pill text-bg-primary">
                        Admin
                    </span>
                }
                else if (User.IsInRole("Operator"))
                {
                    <a href="/Operator"
                       class="badge rounded-pill text-bg-secondary text-decoration-none">
                        Operator
                    </a>
                }
                else if (User.IsInRole("Supervisor"))
                {
                    <span class="badge rounded-pill text-bg-info">
                        Supervisor
                    </span>
                }

                <form method="post"
                      asp-page="/Account/Login"
                      asp-page-handler="Logout"
                      class="ms-lg-3">

                    <button type="submit" class="nav-link btn btn-link">
                        Sign out
                    </button>

                </form>
            }
            else
            {
                <a class="nav-link text-dark"
                   asp-page="/Account/Login">
                    Sign in
                </a>
            }

        </div>
    </div>
</nav>