@model QMSSystem.Shared.DTOs.OperatorChangeRequest

<div class="card">
    <div class="card-header">
        <h3>Particulars</h3>
    </div>

    <div class="card-body">

        <p><strong>Id:</strong> @Model.Id</p>

        <p><strong>Document Id:</strong> @Model.DocumentId</p>

        <p><strong>Title:</strong> @Model.Title</p>

        <p><strong>Change Type:</strong> @Model.ChangeType</p>

        <p><strong>Description:</strong> @Model.Description</p>

        <p><strong>Requested By User Id:</strong> @Model.RequestedByUserId</p>

        <p><strong>Requested Date:</strong> @Model.RequestedDate</p>

        <hr />

        <h4>Event Details</h4>

        <p><strong>Status:</strong> @Model.Status</p>

        <p><strong>Decision:</strong> @(Model.Decision ?? "Not Reviewed")</p>

        <p><strong>Decision Comment:</strong> @(Model.DecisionComment ?? "No Comments")</p>

        <p><strong>Decision By User Id:</strong> @(Model.DecisionByUserId.HasValue? Model.DecisionByUserId.Value.ToString() : "N/A")</p>

        <p><strong>Decision Date:</strong>  @(Model.DecisionDate.HasValue? Model.DecisionDate.Value.ToString("dd-MM-yyyy HH:mm:ss") : "N/A")</p>

    </div>
</div>