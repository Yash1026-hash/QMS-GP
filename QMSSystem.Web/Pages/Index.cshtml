@page
@model IndexModel
@{
    ViewData["Title"] = "Quality Management System";
}

<div class="py-4">
    <!-- HERO SECTION -->
    <section class="landing-hero mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="eyebrow d-inline-block mb-2">Quality Management System (QMS)</span>
                <h1 class="display-6 fw-bold mb-3 text-dark">
                    Industrial Quality &amp; Compliance Governance Platform
                </h1>
                <p class="lead text-muted mb-4 fs-6">
                    A centralized, audit-ready digital system engineered for manufacturing and regulated industrial environments. 
                    Streamline controlled document lifecycles, operational deviation investigations, corrective actions (CAPA), 
                    and engineering change controls with full traceability.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-light text-secondary border px-3 py-2 fw-medium">ISO 9001 Aligned</span>
                    <span class="badge bg-light text-secondary border px-3 py-2 fw-medium">Tamper-Evident Audit Trails</span>
                    <span class="badge bg-light text-secondary border px-3 py-2 fw-medium">Role-Based Access Control</span>
                    <span class="badge bg-light text-secondary border px-3 py-2 fw-medium">Closed-Loop CAPA</span>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-muted align-self-center">Signed in as <strong>@User.Identity.Name</strong></span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="/Admin/Index" class="btn btn-primary px-4 py-2">Go to Admin Dashboard &rarr;</a>
                        }
                        else if (User.IsInRole("Supervisor"))
                        {
                            <a asp-page="/Supervisor/Index" class="btn btn-primary px-4 py-2">Go to Supervisor Dashboard &rarr;</a>
                        }
                        else if (User.IsInRole("Operator"))
                        {
                            <a asp-page="/Operator/Index" class="btn btn-primary px-4 py-2">Go to Operator Dashboard &rarr;</a>
                        }
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="btn btn-primary px-4 py-2">Sign in to Portal &rarr;</a>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border bg-light shadow-sm">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-dark">Portal Quick Access</h6>
                        <ul class="list-unstyled mb-4 small text-muted">
                            <li class="mb-2 d-flex align-items-start gap-2">
                                <span class="badge bg-primary text-white mt-1">1</span>
                                <div><strong>Operator:</strong> Request SOPs, log non-conformances, submit CAPA reports &amp; change requests.</div>
                            </li>
                            <li class="mb-2 d-flex align-items-start gap-2">
                                <span class="badge bg-info text-dark mt-1">2</span>
                                <div><strong>Supervisor:</strong> Review SOPs, evaluate deviations, endorse reports &amp; approve change requests.</div>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <span class="badge bg-dark text-white mt-1">3</span>
                                <div><strong>Administrator:</strong> Manage system users, configure master data, and audit operations.</div>
                            </li>
                        </ul>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-page="/Account/Login" class="btn btn-outline-primary w-100 btn-sm">Sign In to Continue</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHAT IS THIS PROJECT / ABOUT THIS PROJECT -->
    <section class="mb-5">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card landing-card h-100 p-4">
                    <span class="eyebrow mb-2">Project Overview</span>
                    <h2 class="h4 fw-bold mb-3">What is this Project?</h2>
                    <p class="text-muted small mb-3">
                        The <strong>Quality Management System (QMS)</strong> is an enterprise software solution designed to transition manual, paper-heavy plant records into an integrated, auditable digital workflow. It ensures that every standard operating procedure, shop floor incident, and process revision is documented, verified, and approved according to strict quality guidelines.
                    </p>
                    <p class="text-muted small mb-0">
                        Built for industrial compliance, the system prevents undocumented deviations, prevents unauthorized changes to procedures or machinery parameters, and maintains end-to-end accountability from operator reporting to supervisor sign-off.
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card landing-card h-100 p-4">
                    <span class="eyebrow mb-2">Quality &amp; Compliance Objectives</span>
                    <h2 class="h4 fw-bold mb-3">About this System</h2>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="mb-3 d-flex gap-2">
                            <span class="text-primary fw-bold">&bull;</span>
                            <div>
                                <strong>Controlled Document Governance:</strong> Eliminates obsolete documentation on the production line by enforcing structured authoring, supervisor approval, and versioning.
                            </div>
                        </li>
                        <li class="mb-3 d-flex gap-2">
                            <span class="text-primary fw-bold">&bull;</span>
                            <div>
                                <strong>Prompt Incident Resolution:</strong> Provides real-time capture of production anomalies, root-cause categorization, and immediate containment measures.
                            </div>
                        </li>
                        <li class="mb-3 d-flex gap-2">
                            <span class="text-primary fw-bold">&bull;</span>
                            <div>
                                <strong>Closed-Loop Change Control:</strong> Ensures no procedure, tooling, or equipment modification occurs without risk assessment and formal supervisor authorization.
                            </div>
                        </li>
                        <li class="d-flex gap-2">
                            <span class="text-primary fw-bold">&bull;</span>
                            <div>
                                <strong>Immutable Audit Trails:</strong> Every user action, state change, and decision timestamp is recorded in an audit trail log for regulatory inspection readiness.
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE FUNCTIONAL MODULES -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="eyebrow">Functional Architecture</span>
                <h2 class="h4 fw-bold mb-1">Core Operational Modules</h2>
                <p class="text-muted small mb-0">Four interconnected modules driving end-to-end industrial quality assurance.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- MODULE 1 -->
            <div class="col-sm-6 col-lg-3">
                <div class="card landing-card h-100 p-4 d-flex flex-column">
                    <div class="module-badge text-primary mb-2">Module 01</div>
                    <h5 class="fw-bold mb-2">Document Control</h5>
                    <p class="text-muted small flex-grow-1">
                        Central repository for Standard Operating Procedures (SOPs), technical manuals, and work instructions with multi-tier approval workflows.
                    </p>
                    <div class="border-top pt-2 mt-2">
                        <span class="badge bg-light text-dark border small">Draft &bull; Review &bull; Approve</span>
                    </div>
                </div>
            </div>

            <!-- MODULE 2 -->
            <div class="col-sm-6 col-lg-3">
                <div class="card landing-card h-100 p-4 d-flex flex-column">
                    <div class="module-badge text-primary mb-2">Module 02</div>
                    <h5 class="fw-bold mb-2">Deviation Management</h5>
                    <p class="text-muted small flex-grow-1">
                        Real-time logging of operational non-conformances against active SOPs with occurrence logging, root-cause categorisation, and initial containment.
                    </p>
                    <div class="border-top pt-2 mt-2">
                        <span class="badge bg-light text-dark border small">Log &bull; Assess &bull; Triage</span>
                    </div>
                </div>
            </div>

            <!-- MODULE 3 -->
            <div class="col-sm-6 col-lg-3">
                <div class="card landing-card h-100 p-4 d-flex flex-column">
                    <div class="module-badge text-primary mb-2">Module 03</div>
                    <h5 class="fw-bold mb-2">Deviation Reports &amp; CAPA</h5>
                    <p class="text-muted small flex-grow-1">
                        Comprehensive investigation reporting linking root-cause analyses, corrective action plans, risk evaluations, and supervisor validation.
                    </p>
                    <div class="border-top pt-2 mt-2">
                        <span class="badge bg-light text-dark border small">Investigate &bull; CAPA &bull; Resolve</span>
                    </div>
                </div>
            </div>

            <!-- MODULE 4 -->
            <div class="col-sm-6 col-lg-3">
                <div class="card landing-card h-100 p-4 d-flex flex-column">
                    <div class="module-badge text-primary mb-2">Module 04</div>
                    <h5 class="fw-bold mb-2">Change Request Control</h5>
                    <p class="text-muted small flex-grow-1">
                        Rigorous change governance across documentation, machinery, and manufacturing processes with structured justification and supervisor decisions.
                    </p>
                    <div class="border-top pt-2 mt-2">
                        <span class="badge bg-light text-dark border small">Propose &bull; Evaluate &bull; Approve</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ROLE-BASED WORKFLOW MATRIX -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="eyebrow">System Roles &amp; Responsibilities</span>
                <h2 class="h4 fw-bold mb-1">Role-Based Operational Matrix</h2>
                <p class="text-muted small mb-0">Enforcing segregation of duties across all plant operations.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card landing-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold mb-0">Operator</h5>
                        <span class="badge bg-secondary">Execution</span>
                    </div>
                    <p class="text-muted small mb-3">Frontline personnel responsible for executing procedures and logging operational events:</p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-2">&check; Initiate new document / SOP requests</li>
                        <li class="mb-2">&check; Log deviations against active SOPs</li>
                        <li class="mb-2">&check; Submit detailed deviation investigation reports</li>
                        <li>&check; Raise change requests with technical justification</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card landing-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold mb-0">Supervisor</h5>
                        <span class="badge bg-info text-dark">Verification</span>
                    </div>
                    <p class="text-muted small mb-3">Technical leads responsible for reviewing, verifying, and deciding on quality actions:</p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-2">&check; Review and approve controlled SOPs</li>
                        <li class="mb-2">&check; Triage and evaluate submitted deviations</li>
                        <li class="mb-2">&check; Verify deviation investigation reports &amp; CAPAs</li>
                        <li>&check; Approve or reject change requests with comments</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card landing-card h-100 p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold mb-0">Administrator</h5>
                        <span class="badge bg-dark">Governance</span>
                    </div>
                    <p class="text-muted small mb-3">System stewards responsible for platform security, access, and compliance records:</p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-2">&check; User management &amp; role assignments</li>
                        <li class="mb-2">&check; Master data configuration (plants, categories)</li>
                        <li class="mb-2">&check; Immutable audit trail logs &amp; export</li>
                        <li>&check; System health and regulatory compliance oversight</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- CALL TO ACTION BANNER -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <section class="card landing-card p-4 text-center bg-white">
            <div class="py-3">
                <span class="eyebrow d-block mb-1">Get Started</span>
                <h3 class="h4 fw-bold mb-2">Access the Quality Management System</h3>
                <p class="text-muted small mb-4 mx-auto" style="max-width: 600px;">
                    Sign in with your authorized plant credentials to access your designated workspace, review pending quality records, or submit new requests.
                </p>
                <a asp-page="/Account/Login" class="btn btn-primary px-5 py-2">
                    Sign in to Continue &rarr;
                </a>
            </div>
        </section>
    }
</div>
